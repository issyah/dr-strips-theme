    "faq": {
      "type": "landing-faq",
      "blocks": {
        "block_01": {
          "type": "faq_group",
          "settings": {
            "label": "Product & usage",
            "count_label": "04"
          }
        },
        "block_02": {
          "type": "faq_item",
          "settings": {
            "question": "What exactly is a Dr.Strips+ strip?",
            "answer": "<p>A thin film that dissolves on your tongue in under a minute. Strip2Cell delivery carries the actives through the mucosal tissue in your mouth and into your bloodstream, rather than routing them through your gut and liver. No water, no capsule, nothing to swallow.</p>"
          }
        },
        "block_03": {
          "type": "faq_item",
          "settings": {
            "question": "When and how do I take it?",
            "answer": "<p>Ten minutes before bedtime. One strip on your tongue, let it dissolve, no water. Avoid eating or drinking for a couple of minutes afterwards. One strip a night.</p>"
          }
        },
        "block_04": {
          "type": "faq_item",
          "settings": {
            "question": "Will I wake up groggy?",
            "answer": "<p>That heaviness usually comes from an overdose of synthetic melatonin still in your system past sunrise. This formula is calibrated to a plant-derived signal and clears with your own rhythm.</p>"
          }
        },
        "block_05": {
          "type": "faq_item",
          "settings": {
            "question": "Is it habit-forming?",
            "answer": "<p>No. There is no dependency mechanism and no need to escalate the dose. Night thirty behaves like night three.</p>"
          }
        },
        "block_06": {
          "type": "faq_group",
          "settings": {
            "label": "The formula",
            "count_label": "04"
          }
        },
        "block_07": {
          "type": "faq_item",
          "settings": {
            "question": "Why pistachio instead of melatonin?",
            "answer": "<p>Pistachio extract is one of the richest natural sources of phytomelatonin — the plant-derived form of the same signal your body already reads, delivered with its natural cofactors instead of isolated in a lab.</p>"
          }
        },
        "block_08": {
          "type": "faq_item",
          "settings": {
            "question": "What does it taste like?",
            "answer": "<p>Mixed berry, sweetened with monk fruit and steviol glycosides. Zero sugar, and it is gone in under a minute.</p>"
          }
        },
        "block_09": {
          "type": "faq_item",
          "settings": {
            "question": "Can I take it alongside other supplements or medication?",
            "answer": "<p>It is a health supplement for generally healthy adults, not a medicine. If you are pregnant, nursing, taking medication or managing a condition, speak to your doctor before use. Keep out of reach of children.</p>"
          }
        },
        "block_10": {
          "type": "faq_item",
          "settings": {
            "question": "Can I see the lab report for my box?",
            "answer": "<p>Yes. Every batch is third-party tested for potency and purity. Quote the batch number printed on your box and we will send the certificate of analysis for that batch.</p>"
          }
        },
        "block_11": {
          "type": "faq_group",
          "settings": {
            "label": "Shipping & delivery",
            "count_label": "03"
          }
        },
        "block_12": {
          "type": "faq_item",
          "settings": {
            "question": "What does shipping cost?",
            "answer": "<p>Free on one-time orders above S$100, and free on every subscription. Below that, standard Singapore delivery is charged at checkout.</p>"
          }
        },
        "block_13": {
          "type": "faq_item",
          "settings": {
            "question": "How quickly does it arrive?",
            "answer": "<p>Orders placed before the daily cut-off leave the same or next working day and usually land within one to three working days.</p>"
          }
        },
        "block_14": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship outside Singapore?",
            "answer": "<p>Not yet. Singapore only for now.</p>"
          }
        },
