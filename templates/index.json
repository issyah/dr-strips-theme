          "settings": {
            "question": "How does the 30-night guarantee work?",
            "answer": "<p>Take it for thirty nights — the full box. If nothing changes, email us and we refund it. No return, no forms, no questions.</p>"
          }
        },
        "block_17": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pause or cancel a subscription?",
            "answer": "<p>Any time, from your account. No notice period and no fee.</p>"
          }
        },
        "block_18": {
          "type": "faq_item",
          "settings": {
            "question": "My box arrived damaged or wrong.",
            "answer": "<p>Send us your order number and a photo within seven days of delivery and we will replace it or refund it at no cost to you.</p>"
          }
        },
