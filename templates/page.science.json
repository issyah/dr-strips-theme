    "science_hero": {
      "type": "landing-science-hero",
      "settings": {
        "eyebrow": "The delivery science",
        "heading": "The dose on\nthe box,\ndelivered.",
        "intro_text": "Every supplement is sold on what goes into it. The number that decides whether it works is how much of that ever reaches your blood. This page is the physiology of that gap, the route we take instead, and the limits of what either can tell you.",
        "cta1_label": "Start with the route",
        "cta1_url": "#route",
        "cta2_label": "Jump to the sources",
        "cta2_url": "#sources",
        "panel_label": "Dose still intact on arrival",
        "swallow_label": "Swallowed",
        "swallow_text": "A fraction of the label. How much depends on the compound.",
        "film_label": "Strip2Cell film",
        "panel_footnote": "*Up to 90% is the ceiling of the sublingual route for actives suited to it, drawn from published pharmacology — not a claim about a specific outcome. We publish no figure for pills or gummies, because it changes with the compound."
      }
    },
    "science_route": {
      "type": "landing-science-route",
      "blocks": {
        "block_01": {
          "type": "card",
          "settings": {
            "label": "Stomach",
            "title": "Acid, then enzymes",
            "text": "Breakdown starts before absorption does. Botanicals and peptides are the least forgiving of this stage."
          }
        },
        "block_02": {
          "type": "card",
          "settings": {
            "label": "Small intestine",
            "title": "Only part crosses",
            "text": "What survives has to pass the gut wall. What it finds there — food, timing, your own gut — changes the answer nightly."
          }
        },
        "block_03": {
          "type": "card",
          "settings": {
            "label": "Liver, then blood",
            "title": "The first pass",
            "text": "Everything absorbed from the gut is routed to the liver first, where enzymes metabolise a share of the dose. What survives that is the only part that ever had a job to do — an hour or more after you swallowed it."
          }
        }
      },
      "block_order": [
        "block_01",
        "block_02",
        "block_03"
      ],
      "settings": {
        "eyebrow": "01 — The problem",
        "heading": "Your liver gets first pick.",
        "body_1": "Anything you swallow takes the long route. It has to survive the stomach, cross the wall of the small intestine, and then pass through the liver — where enzymes metabolise a share of it — before a single molecule reaches general circulation. Pharmacologists call that last step first-pass metabolism.",
        "body_2": "It is why the figure printed on a panel and the figure in your blood are two different numbers. Not a defect in the formula. A property of the route.",
        "citation": "Goodman & Gilman · The Pharmacological Basis of Therapeutics"
      }
    },
    "science_mucosa": {
      "type": "landing-science-mucosa",
      "blocks": {
        "block_01": {
          "type": "point",
          "settings": {
            "title": "Thin, non-keratinised membrane",
            "text": "Nothing like the barrier lining your gut. It is built to let things through."
          }
        },
        "block_02": {
          "type": "point",
          "settings": {
            "title": "A dense capillary bed beneath it",
            "text": "Blood sits millimetres from the surface, which is why absorption starts in minutes rather than an hour."
          }
        },
        "block_03": {
          "type": "point",
          "settings": {
            "title": "Straight into systemic circulation",
            "text": "The veins draining your mouth do not route through the liver, so nothing is metabolised before it can work."
          }
        }
      },
      "block_order": [
        "block_01",
        "block_02",
        "block_03"
      ],
      "settings": {
        "eyebrow": "02 — The shortcut",
        "heading": "The tissue under your tongue was built for this.",
        "body_1": "The floor of your mouth is one of the most permeable surfaces on the body: a thin, non-keratinised membrane sitting directly over a dense bed of capillaries. Anything that crosses it enters the veins draining the head and neck — which feed general circulation without passing through the liver.",
        "body_2": "No stomach. No gut wall. No first pass. Delivered this way, compounds suited to the route reach far more of the bloodstream than the same compounds swallowed.",
        "citation": "British Journal of Clinical Pharmacology, 2018",
        "image_placeholder_text": "Macro — strip on the tongue, mid-dissolve, single-source light",
        "image_card_label": "Where it happens",
        "image_card_title": "A membrane, then blood",
        "image_card_text": "The film holds itself against the mucosa while it dissolves, so the actives are released exactly where the tissue is thinnest and the capillaries are closest.",
        "borrowed_label": "Borrowed, not invented",
        "borrowed_text": "Medicine has used this route for decades: nitroglycerin placed under the tongue for angina, sublingual B12, prescription oral films. We did not discover the shortcut. We built a nightly supplement around it."
      }
    },
