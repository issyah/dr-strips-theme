          "settings": {
            "label": "Stomach",
            "title": "Acid, then enzymes",
            "text": "Breakdown starts before absorption does. Botanicals and peptides are the least forgiving of this stage."
          }
        },
        "block_02": {
          "type": "card",
          "settings": {
            "label": "Small intestine",
            "title": "Only part crosses",
            "text": "What survives has to pass the gut wall. What it finds there — food, timing, your own gut — changes the answer nightly."
          }
        },
        "block_03": {
          "type": "card",
          "settings": {
            "label": "Liver, then blood",
            "title": "The first pass",
            "text": "Everything absorbed from the gut is routed to the liver first, where enzymes metabolise a share of the dose. What survives that is the only part that ever had a job to do — an hour or more after you swallowed it."
          }
        }
      },
