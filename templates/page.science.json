    "science_limits": {
      "type": "landing-science-limits",
      "blocks": {
        "block_01": {
          "type": "card",
          "settings": {
            "title": "It is not a sedative",
            "text": "The strip supports the body's own wind-down. It does not switch you off, and it is not a treatment for insomnia or any medical condition."
          }
        },
        "block_02": {
          "type": "card",
          "settings": {
            "title": "Up to 90% is a ceiling",
            "text": "It describes what the sublingual route can reach for compounds suited to it, from published pharmacology. It is not a measurement of one person on one night."
          }
        },
        "block_03": {
          "type": "card",
          "settings": {
            "title": "The route is studied; this formula is not a trial",
            "text": "The evidence we cite is on delivery and on individual actives. We have not run a clinical trial on the finished strip, and we will not imply that we have."
          }
        },
        "block_04": {
          "type": "card",
          "settings": {
            "title": "Nights differ, people differ",
            "text": "Caffeine, stress, screens and shift work all outweigh a supplement. The strip is the easy part of a night, not the whole of it."
          }
        }
      },
