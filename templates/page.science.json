      "settings": {
        "eyebrow": "03 — Format",
        "heading": "Same actives.\nDifferent arrival.",
        "body": "A capsule, a gummy and a film can carry an identical ingredient panel. Two of them take the route through the gut and the liver, so what arrives is decided by physiology rather than by the label. The third does not take that route at all.",
        "bars_caption": "Bar length = dose reaching the bloodstream",
        "bars_legend": "Steel = the swallowed route",
        "image": "shopify://shop_images/DRstrip_132of134.jpg",
        "image_placeholder_text": "Macro — the film mid-dissolve, cobalt gel light, crushed blacks",
        "footnote": "The two lower bars carry no percentage on purpose. Published bioavailability for swallowed compounds spans a wide range depending on the molecule, the meal and the person, so a single tidy percentage would be a design decision rather than a fact. Ours is stated as a ceiling, with an asterisk, for the same reason."
      }
    },
    "science_signal": {
      "type": "landing-science-signal",
      "blocks": {
        "block_01": {
          "type": "card",
          "settings": {
            "title": "It works with the rhythm",
            "text": "A cue, not a switch. Your body still runs the night; the strip tells it the night has started."
