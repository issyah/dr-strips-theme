,8.5-.97,2.5-2.4,4.62-4.28,6.35-1.88,1.73-4.18,3.05-6.9,3.95-2.72.9-5.83,1.35-9.33,1.35-7.36,0-13.01-1.95-16.95-5.85-3.94-3.9-5.91-9.49-5.91-16.78v-1.21c0-.4.02-.81.06-1.21h10.98v1.21c0,4.75.95,8.23,2.84,10.46,1.9,2.23,4.81,3.34,8.75,3.34s6.59-.94,8.42-2.81c1.82-1.88,2.73-4.47,2.73-7.78,0-2.54-.54-4.57-1.63-6.1-1.09-1.53-2.75-2.93-5-4.22l-12.14-7.06Z"></path><path d="M215,113.28c0,1.8.12,3.29.36,4.47.24,1.18.68,2.11,1.32,2.79.64.68,1.51,1.15,2.59,1.41,1.08.26,2.47.39,4.17.39,1.07,0,2.08-.04,3.03-.11.96-.07,1.82-.18,2.59-.33v9c-.3.04-.74.09-1.35.16-.61.07-1.3.14-2.07.19-.77.06-1.6.1-2.49.14-.88.04-1.73.06-2.54.06-2.98,0-5.51-.35-7.59-1.05-2.08-.7-3.77-1.81-5.08-3.34-1.31-1.53-2.25-3.51-2.84-5.96-.59-2.45-.88-5.42-.88-8.91v-31.51h-9.77v-8.56h9.77v-15.18l10.76-2.21v17.39h14.02v8.56h-14.02v32.62Z"></path><path d="M235.09,72.11h9.99c.18.96.31,1.9.38,2.84.07.94.15,1.92.22,2.95,1.36-2.21,3.11-3.83,5.24-4.86,2.13-1.03,4.69-1.55,7.67-1.55.33,0,.7.02,1.1.05.4.04.8.08,1.19.14.39.05.73.12,1.05.19.31.07.54.15.69.22v10.87c-.37-.11-.82-.2-1.35-.28-.54-.07-1.1-.15-1.68-.22-.59-.07-1.18-.13-1.77-.17-.59-.04-1.14-.05-1.65-.05-3.57,0-6.18,1.12-7.84,3.37-1.65,2.25-2.48,5.8-2.48,10.65v34.61h-10.76v-58.78Z"></path><path d="M266.39,56.1c0-2.1.65-3.8,1.96-5.11,1.3-1.31,3.02-1.96,5.16-1.96s3.8.65,5.11,1.96c1.3,1.31,1.96,3.01,1.96,5.11s-.65,3.85-1.96,5.16c-1.31,1.31-3.01,1.96-5.11,1.96s-3.85-.65-5.16-1.96c-1.31-1.3-1.96-3.03-1.96-5.16ZM268.1,72.11h10.76v58.78h-10.76v-58.78Z"></path><path d="M288.74,147.95v-75.84h9.99c.33,2.02.55,4.18.66,6.46,2.5-4.67,6.75-7.01,12.75-7.01s10.66,2.2,13.77,6.6c3.11,4.4,4.66,10.88,4.66,19.46v7.78c0,8.57-1.56,15.06-4.66,19.45-3.11,4.4-7.7,6.6-13.77,6.6-2.98,0-5.51-.55-7.59-1.66-2.08-1.1-3.76-2.81-5.05-5.13v23.29h-10.76ZM309.94,122.34c1.73,0,3.22-.32,4.47-.97,1.25-.64,2.28-1.65,3.09-3.01.81-1.36,1.4-3.11,1.77-5.24.37-2.13.55-4.69.55-7.67v-7.84c0-5.96-.78-10.27-2.35-12.92-1.57-2.65-4.09-3.97-7.59-3.97s-6.19,1.22-7.87,3.67c-1.67,2.45-2.51,6.03-2.51,10.74v12.75c0,4.7