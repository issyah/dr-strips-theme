*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#fff;color:#0B0B0C;font-family:'Geist',-apple-system,'Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased;text-wrap:pretty;overflow-x:hidden}
a{color:#0B0B0C;text-decoration:none}
a:hover{color:#55565A}
summary::-webkit-details-marker{display:none}
summary{list-style:none;cursor:pointer}
::selection{background:#0B0B0C;color:#fff}
button{font:inherit}

@keyframes ds-dissolve-loop{0%{width:100%;opacity:1;filter:blur(0)}70%{width:8%;opacity:.9;filter:blur(0)}88%{width:0%;opacity:.2;filter:blur(3px)}100%{width:0%;opacity:0;filter:blur(6px)}}
@keyframes ds-drift{0%{transform:translate3d(0,0,0)}50%{transform:translate3d(0,-10px,0)}100%{transform:translate3d(0,0,0)}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}

/* ---- interactive states (kept separate from base inline styles; !important
   is intentional here so hover/active/focus can override the element's own
   inline base style, mirroring the original design's per-element states) ---- */
.hov-header-cta:hover{background:#E6E7E9 !important;transform:translateY(-1px) !important}
.hov-header-cta:active{transform:scale(.97) !important}
.hov-dark:hover{background:#2A2B2E !important;transform:translateY(-1px) !important}
.hov-dark-sm:active{transform:scale(.98) !important}
.hov-dark-lg:active{transform:scale(.99) !important}
.hov-outline:hover{border-color:#0B0B0C !important;transform:translateY(-2px) !important}
.hov-step:hover{background:#FAFAF9 !important}
.hov-ingredient:hover{transform:translateY(-2px) !important;border-color:#0B0B0C !important}
.hov-review:hover{transform:translateY(-3px) !important;box-shadow:0 10px 30px rgba(11,11,12,.07) !important}
.hov-input:focus{border-color:#0B0B0C !important;box-shadow:0 0 0 3px rgba(11,11,12,.08) !important;outline:none}

/* ---- plan picker selected state ---- */
.plan-card{border-color:#E6E7E9}
.plan-card.selected{border-color:#0B0B0C}
.plan-dot{background:transparent}
.plan-card.selected .plan-dot{background:#0B0B0C}

/* ---- image placeholders (drop real photography in here later) ---- */
.img-slot{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;padding:18px;color:#B9BABD;background:
  repeating-linear-gradient(135deg,rgba(11,11,12,.035) 0 2px,transparent 2px 14px)}
.img-slot svg{opacity:.55}
.img-slot span{font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;line-height:1.6;max-width:220px}

/* ---- toast ---- */
.toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,12px);z-index:80;background:#0B0B0C;color:#fff;border-radius:11px;padding:14px 20px;display:flex;align-items:center;gap:14px;box-shadow:0 14px 40px rgba(11,11,12,.28);opacity:0;pointer-events:none;transition:opacity .28s cubic-bezier(.22,.61,.36,1),transform .28s cubic-bezier(.22,.61,.36,1)}
.toast.show{opacity:1;transform:translate(-50%,0);pointer-events:auto}
</style>
</head>
