{%- comment -%}
  Dr.Strips+ Sleep — full custom landing page template.
  {% layout none %} skips theme.liquid entirely so this page renders its own
  complete <html> document with its own header/footer, independent of the
  active theme's chrome.
{%- endcomment -%}
{% layout none %}
{%- assign product = all_products['dr-strips-sleep'] -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign sub_cents = variant.price | times: 0.85 | round -%}
{%- assign sub_per_night_cents = sub_cents | divided_by: 30.0 | round -%}
{%- assign once_per_night_cents = variant.price | divided_by: 30.0 | round -%}
{%- assign has_sub_plan = false -%}
{%- assign sub_plan_id = '' -%}
{%- for group in product.selling_plan_groups -%}
  {%- for plan in group.selling_plans -%}
    {%- assign has_sub_plan = true -%}
    {%- assign sub_plan_id = plan.id -%}
    {%- break -%}
  {%- endfor -%}
  {%- if has_sub_plan -%}{%- break -%}{%- endif -%}
{%- endfor -%}
