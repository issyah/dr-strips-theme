<div style="margin-top:48px;padding-top:22px;border-top:1px solid #232427;display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075">
