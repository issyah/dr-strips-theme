 style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px 24px;align-items:center"><div style="font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#8A8C91">Swallowed pill</div><div style="grid-column:span 2;min-width:280px;display:flex;gap:18px;align-items:center"><div style="flex:1;position:relative;height:54px"><div style="position:absolute;top:26px;left:0;right:0;height:1px;background:#232427"></div><div style="position:absolute;top:4px;left:20%;width:26%;bottom:4px;border-left:1px dashed #2C2D30;border-right:1px dashed #2C2D30"></div><div style="position:absolute;top:-6px;left:calc(20% + 6px);font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075">Gut</div><div style="position:absolute;top:4px;left:46%;width:34%;bottom:4px;border-left:1px dashed #2C2D30;border-right:1px dashed #2C2D30"></div><div style="position:absolute;top:-6px;left:calc(46% + 6px);font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075">Liver</div><div data-runner="A" style="position:absolute;top:14px;left:0;height:26px;width:116px;background:#A9ABAF;border-radius:4px"></div><div style="position:absolute;top:8px;right:0;bottom:8px;width:1px;background:#2C2D30"></div><div data-arrive="A" style="position:absolute;top:-7px;right:0;font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#8A8C91">Arrives · 60 min</div></div><div style="width:82px;text-align:right;flex:none"><div style="font-family:'Geist Mono',monospace;font-size:30px;letter-spacing:-.03em;color:#A9ABAF"><span data-intact="A">35</span></div><div style="font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075;margin-top:4px">of 100 intact</div></div></div></div></div><div style="display:flex;flex-wrap:wrap;gap:34px;margin-top:26px;border-top: