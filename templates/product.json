    "pdp_hero": {
      "type": "landing-pdp-hero",
      "blocks": {
        "block_01": {
          "type": "item",
          "settings": {
            "title": "Description",
            "content": "<p>Dr.Strips+ Sleep is a fast-dissolving oral strip designed to fit into the wind-down you already have. One strip, on your tongue, about ten minutes before bed — no water, no capsule, nothing to swallow.</p>"
          }
        },
        "block_02": {
          "type": "item",
          "settings": {
            "title": "What it does",
            "content": "<p>Each strip carries a small, considered blend of actives designed to work with your body's own wind-down signals rather than force sleep on top of it — quieting a racing mind and easing you toward rest, night after night.</p>"
          }
        },
        "block_03": {
          "type": "item",
          "settings": {
            "title": "Ingredients",
            "content": "<p>Pistachio extract (a natural source of phytomelatonin), GABA, valerian root extract, passion flower and chamomile — five actives, each chosen for a specific mechanism rather than for length of label.</p><p><a href=\"/pages/ingredient-library\">See the complete ingredient breakdown →</a></p>"
          }
        },
        "block_04": {
          "type": "item",
          "settings": {
            "title": "Formula & When to use",
            "content": "<p>Take one strip on your tongue about ten minutes before bed and let it dissolve on its own — no chewing, no water. One strip a night is the full dose; there's no need to increase it over time.</p>"
          }
        },
        "block_05": {
          "type": "item",
          "settings": {
            "title": "Shipping",
            "content": "<p>Free shipping on one-time orders above S$100, and free on every subscription. Orders placed before the daily cut-off usually arrive within one to three working days. Singapore only, for now.</p>"
          }
        }
      },
