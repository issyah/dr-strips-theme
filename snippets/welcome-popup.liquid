<script>
  (function () {
    // ---- CONFIG ----
    var SHOW_DELAY_MS = 7000;
    var SHOW_ONCE_PER_SESSION = true;
    var DISCOUNT_CODE = 'EARLY';
    var STORAGE_KEY = 'dsp_seen_v1';
    var WIN_LINES = [
      [0, 1, 2],
      [3, 4, 5],
      [6, 7, 8],
      [0, 3, 6],
      [1, 4, 7],
      [2, 5, 8],
      [0, 4, 8],
      [2, 4, 6],
    ];
    function checkWinner(board, mark) {
      for (var i = 0; i < WIN_LINES.length; i++) {
        var l = WIN_LINES[i];
        if (board[l[0]] === mark && board[l[1]] === mark && board[l[2]] === mark) return l;
      }
      return null;
    }
    function emptyCells(board) {
      var out = [];
      for (var i = 0; i < 9; i++) if (!board[i]) out.push(i);
      return out;
    }
    // Full look-ahead (the board has at most 9 cells, so this is cheap):
    // returns true if, from this state, the bot can play out the rest of
    // the game — no matter what the visitor does — without ever completing
    // three in a row itself. Used by generous mode below so it can rule out
    // not just an immediate win but any move that would eventually box the
    // bot into a forced win later (a real edge case in the previous
    // one-move-lookahead version of this function, caught during testing).
    function botHasNonWinningPath(board, botTurn) {
      if (checkWinner(board, 'O')) return false;
      var empties = emptyCells(board);
      if (checkWinner(board, 'X') || empties.length === 0) return true;
      if (botTurn) {
        for (var i = 0; i < empties.length; i++) {
          var next = board.slice();
          next[empties[i]] = 'O';
          if (checkWinner(next, 'O')) continue;
          if (botHasNonWinningPath(next, false)) return true;
        }
        return false;
      }
      for (var j = 0; j < empties.length; j++) {
        var reply = board.slice();
        reply[empties[j]] = 'X';
        if (!botHasNonWinningPath(reply, true)) return false;
      }
      return true;
    }
    // In generous mode (75% of games, the default) the bot picks only among
    // moves it can prove never lead to a house win, and prefers — among
    // those — one that doesn't block the visitor's winning move, so games
    // in this mode always end in a player win or a draw. In competitive
    // mode (the other 25%, see houseCompetitive) the bot plays for real: it
    // takes a winning move when it has one and blocks the player's winning
    // move otherwise, so the house has a genuine chance to win.
    function pickBotMove(board, competitive) {
      var empties = emptyCells(board);
      if (competitive) {
        for (var w = 0; w < empties.length; w++) {
          var testWin = board.slice();
          testWin[empties[w]] = 'O';
          if (checkWinner(testWin, 'O')) return empties[w]; // take the win
        }
        for (var b = 0; b < empties.length; b++) {
          var testBlock = board.slice();
          testBlock[empties[b]] = 'X';
          if (checkWinner(testBlock, 'X')) return empties[b]; // block the player
        }
        var preferredOrder = [4, 0, 2, 6, 8, 1, 3, 5, 7];
        for (var p = 0; p < preferredOrder.length; p++) {
          if (empties.indexOf(preferredOrder[p]) !== -1) return preferredOrder[p];
        }
        return empties[Math.floor(Math.random() * empties.length)];
      }
      var candidates = empties.filter(function (i) {
        var next = board.slice();
        next[i] = 'O';
        if (checkWinner(next, 'O')) return false; // never win immediately
        return botHasNonWinningPath(next, false); // ...or ever, down this path
      });
      var nonBlocking = candidates.filter(function (i) {
        var testX = board.slice();
        testX[i] = 'X';
        return !checkWinner(testX, 'X'); // prefer leaving the visitor's win open
      });
      var pool = nonBlocking.length ? nonBlocking : candidates.length ? candidates : empties;
      return pool[Math.floor(Math.random() * pool.length)];
    }
    function xIcon() {
      return '<svg viewBox="0 0 24 24" fill="none"><path d="M4 4L20 20M20 4L4 20" stroke="#0B0B0C" stroke-width="3.2" stroke-linecap="round"/></svg>';
    }
    function oIcon() {
      return '<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="#8A8C91" stroke-width="3.2"/></svg>';
    }
    document.addEventListener('DOMContentLoaded', function () {
      var overlay = document.getElementById('dsp-overlay');
      var boardEl = document.getElementById('dsp-board');
      var statusEl = document.getElementById('dsp-status');
      var gameStep = document.getElementById('dsp-game-step');
      var emailStep = document.getElementById('dsp-email-step');
      var codeStep = document.getElementById('dsp-code-step');
      var closeBtn = document.getElementById('dsp-close');
      var emailForm = document.getElementById('dsp-email-form');
      var emailInput = document.getElementById('dsp-email-input');
      var emailError = document.getElementById('dsp-email-error');
      var emailSubmitBtn = document.getElementById('dsp-email-submit');
      var copyBtn = document.getElementById('dsp-copy-btn');
      var copyNote = document.getElementById('dsp-copy-note');
      var codeTextEl = document.getElementById('dsp-code-text');
      var unlockFallbackTimer = null;
      var resultEyebrowEl = document.getElementById('dsp-result-eyebrow');
      var resultHeadingEl = document.getElementById('dsp-result-heading');
      var resultSubEl = document.getElementById('dsp-result-sub');
      // Rolled fresh each game in botOpensGame(): 25% of games let the house
      // play competitively instead of always running in generous mode. See
      // pickBotMove and the WIN ODDS note at the top of this file.
      var houseCompetitive = false;
      codeTextEl.textContent = DISCOUNT_CODE;
      var board = new Array(9).fill(null);
      var over = false;
      function renderBoard() {
        boardEl.innerHTML = '';
        board.forEach(function (mark, i) {
          var cell = document.createElement('div');
          cell.className = 'dsp-cell' + (mark ? ' dsp-taken' : '');
          cell.dataset.i = i;
          if (mark === 'X') cell.innerHTML = xIcon();
          if (mark === 'O') cell.innerHTML = oIcon();
          cell.addEventListener('click', onCellClick);
          boardEl.appendChild(cell);
        });
      }
      function highlightWin(line) {
        var cells = boardEl.children;
        line.forEach(function (i) {
          cells[i].classList.add('dsp-win');
        });
      }
      function endGame(outcome) {
        // The code unlocks after the game regardless of outcome (see the
        // emailForm submit handler below) — winning is just for fun, so
        // every branch here still leads to the email step.
        over = true;
        if (outcome === 'house') {
          statusEl.textContent = 'house wins this round!';
          resultEyebrowEl.textContent = 'so close';
          resultHeadingEl.textContent = 'So close!';
          resultSubEl.textContent = "The house got this one — but your code's still unlocked. Drop your email below.";
        } else if (outcome === 'draw') {
          statusEl.textContent = "it's a draw!";
          resultEyebrowEl.textContent = 'good game';
          resultHeadingEl.textContent = "It's a draw.";
          resultSubEl.textContent = "Drop your email and we'll unlock your code — just a quick refresh.";
        } else {
          statusEl.textContent = 'you win!';
          resultEyebrowEl.textContent = 'you won';
          resultHeadingEl.textContent = 'Nice round.';
          resultSubEl.textContent = "Drop your email and we'll unlock your code — just a quick refresh.";
        }
        setTimeout(function () {
          gameStep.classList.add('dsp-hidden');
          emailStep.classList.add('dsp-active');
          emailInput.focus();
        }, 700);
      }
      // The house opens with the center square — a clear, deliberate first
      // move so it's obvious from the moment the card appears that this is
      // a live game against "the house" and not just a static graphic.
      // Also where each new game's odds are rolled: 25% of the time the
      // house plays competitively (see pickBotMove / houseCompetitive).
      function botOpensGame() {
        houseCompetitive = Math.random() < 0.25;
        boardEl.classList.add('dsp-thinking');
        setTimeout(function () {
          board[4] = 'O';
          renderBoard();
          boardEl.classList.remove('dsp-thinking');
          statusEl.textContent = 'your move';
        }, 650);
      }
      function onCellClick(e) {
        if (over) return;
        var i = parseInt(e.currentTarget.dataset.i, 10);
        if (board[i]) return;
        board[i] = 'X';
        renderBoard();
        var winLine = checkWinner(board, 'X');
        if (winLine) {
          highlightWin(winLine);
          endGame('player');
          return;
        }
        if (!emptyCells(board).length) {
          endGame('draw');
          return;
        }
        boardEl.classList.add('dsp-thinking');
        statusEl.textContent = 'house is thinking...';
        setTimeout(function () {
          var move = pickBotMove(board, houseCompetitive);
          board[move] = 'O';
          renderBoard();
          boardEl.classList.remove('dsp-thinking');
          var oLine = checkWinner(board, 'O');
          if (oLine) {
            highlightWin(oLine);
            endGame('house');
            return;
          }
          if (!emptyCells(board).length) {
            endGame('draw');
            return;
          }
          statusEl.textContent = 'your move';
        }, 500);
      }
      renderBoard();

      function openPopupImmediately() {
        overlay.classList.add('dsp-show');
        requestAnimationFrame(function () {
          overlay.classList.add('dsp-visible');
        });
      }

      // Genuinely subscribes the visitor to Shopify's own marketing
      // list via a real top-level submission of the hidden native
      // Shopify newsletter form declared near the top of this snippet.
      // This causes a real, brief page reload — see the top-of-file
      // comment for why that trade-off was made deliberately after an
      // instant/hidden-iframe version proved unreliable in testing.
      // `Shopify.captcha.protect()` + `requestSubmit()` (not `submit()`)
      // are both required for this store's hCaptcha bot protection to
      // accept the submission — confirmed by direct testing.
      function subscribeToNewsletter(email) {
        var emailField = document.getElementById('dsp-newsletter-email');
        var form = document.getElementById('dsp-newsletter-form');
        if (!emailField || !form) return;
        emailField.value = email;
        // Wrapped in try/catch: if Shopify's captcha helper throws (seen when
        // the hCaptcha script hasn't fully initialized yet), it must not stop
        // the form submission below from being attempted.
        try {
          if (window.Shopify && window.Shopify.captcha && typeof window.Shopify.captcha.protect === 'function') {
            window.Shopify.captcha.protect(form);
          }
        } catch (err) {}
        try {
          if (form.requestSubmit) {
            form.requestSubmit();
          } else {
            form.submit(); // very old browsers without requestSubmit support
          }
        } catch (err) {}
      }

      emailForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var val = emailInput.value.trim();
        var ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
        if (!ok) {
          emailError.textContent = 'enter a valid email to unlock your code.';
          return;
        }
        emailError.textContent = '';
        emailSubmitBtn.disabled = true;
        emailSubmitBtn.textContent = 'Unlocking…';
        // Mark that the popup should reopen straight on the code step
        // after the reload this triggers, in case the redirect ever
        // lands back here without the ?customer_posted=true query param
        // being read in time (belt-and-braces; the query param is the
        // primary signal, checked below).
        try {
          sessionStorage.setItem(STORAGE_KEY, '1');
        } catch (err) {}
        // Safety net: the reload above depends on Shopify's hCaptcha check
        // completing. If that check is blocked or silently stalls (ad
        // blockers, privacy extensions, and flaky networks are the usual
        // causes), the page never reloads and a visitor is stuck on
        // "Unlocking…" forever with no way out. A genuine reload tears this
        // whole script (and this timer) down with the page, so this can only
        // ever fire when the reload truly never happened — in that case,
        // reveal the code anyway rather than trap the visitor.
        clearTimeout(unlockFallbackTimer);
        unlockFallbackTimer = setTimeout(function () {
          emailSubmitBtn.disabled = false;
          emailSubmitBtn.textContent = 'Reveal my code';
          emailError.textContent = '';
          gameStep.classList.add('dsp-hidden');
          emailStep.classList.remove('dsp-active');
          codeStep.classList.add('dsp-active');
        }, 8000);
        subscribeToNewsletter(val);
      });

      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(DISCOUNT_CODE).then(function () {
          copyNote.textContent = 'copied!';
          setTimeout(function () {
            copyNote.textContent = ' ';
          }, 1500);
        });
      });
      function closePopup() {
        overlay.classList.remove('dsp-visible');
        setTimeout(function () {
          overlay.classList.remove('dsp-show');
        }, 300);
      }
      closeBtn.addEventListener('click', closePopup);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closePopup();
      });

      // Detect returning from a successful newsletter subscribe: Shopify
      // redirects back to the same page with ?customer_posted=true once
      // the `form` (type: 'customer') submission above completes. When
      // present, skip straight to the code step instead of restarting
      // the game or waiting out the normal 7-second delay, then clean
      // the URL so a page refresh doesn't repeat this.
      var params = new URLSearchParams(window.location.search);
      if (params.get('customer_posted') === 'true') {
        gameStep.classList.add('dsp-hidden');
        codeStep.classList.add('dsp-active');
        openPopupImmediately();
        try {
          sessionStorage.setItem(STORAGE_KEY, '1');
        } catch (err) {}
        params.delete('customer_posted');
        var cleanedSearch = params.toString();
        var cleanedUrl =
          window.location.pathname +
          (cleanedSearch ? '?' + cleanedSearch : '') +
          window.location.hash.replace('#dsp-newsletter-form', '');
        window.history.replaceState(null, '', cleanedUrl);
        return;
      }

      var alreadySeen = SHOW_ONCE_PER_SESSION && sessionStorage.getItem(STORAGE_KEY);
      if (!alreadySeen) {
        setTimeout(function () {
          openPopupImmediately();
          botOpensGame();
          if (SHOW_ONCE_PER_SESSION) sessionStorage.setItem(STORAGE_KEY, '1');
        }, SHOW_DELAY_MS);
      }
    });
  })();
</script>
