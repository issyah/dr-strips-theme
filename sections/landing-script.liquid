{%- liquid
  assign product = all_products[section.settings.product]
  assign variant = product.selected_or_first_available_variant
  assign has_sub_plan = false
  assign sub_plan_id = ''
  assign sub_cents = variant.price
  for allocation in variant.selling_plan_allocations
    assign has_sub_plan = true
    assign sub_plan_id = allocation.selling_plan.id
    assign sub_cents = allocation.price
    break
  endfor
-%}
<script>
(function(){
  "use strict";
  var EASE = 'cubic-bezier(.22,.61,.36,1)';
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var rise = !reduced;

  var VARIANT_ID = {{ variant.id | json }};
  var HAS_SUB_PLAN = {{ has_sub_plan | json }};
  var SUB_PLAN_ID = {{ sub_plan_id | json }};
  var SUB_PRICE_TEXT = "S${{ sub_cents | money | remove: '$' }} / month";
  var ONCE_PRICE_TEXT = "S${{ variant.price | money | remove: '$' }}";

  var subCard = document.querySelector('[data-plan="sub"]');
  var onceCard = document.querySelector('[data-plan="once"]');

  // A real subscriptions app is now installed and both the PDP
  // (landing-pdp-hero.liquid) and the homepage offer section
  // (landing-offer.liquid) render real [data-plan="sub"]/[data-plan="once"]
  // selector cards. On a page that actually has that selector, default to
  // the subscription (the better long-term value) since the shopper can see
  // and switch the selection themselves. On any other page — the header CTA
  // or the Science page's CTA box, neither of which has a selector — default
  // to one-time so a stray "Add to bag" click never silently subscribes
  // someone with no way to have seen or changed that choice.
  var initialPlan = (HAS_SUB_PLAN && (subCard || onceCard)) ? 'sub' : 'once';
  var state = { plan: initialPlan, qty: 1, bag: 0 };
  var bagLabelEls = document.querySelectorAll('[data-bag-label]');
  var ctaPriceEls = document.querySelectorAll('[data-cta-price]');
  var qtyEl = document.querySelector('[data-pdp-qty-value]');
  var qtyMinusBtn = document.querySelector('[data-pdp-qty-minus]');
  var qtyPlusBtn = document.querySelector('[data-pdp-qty-plus]');
  var toastTimer = null;

  function renderPlan(){
    var sub = state.plan === 'sub';
    if (subCard) { subCard.classList.toggle('selected', sub); subCard.setAttribute('aria-pressed', String(sub)); }
    if (onceCard) { onceCard.classList.toggle('selected', !sub); onceCard.setAttribute('aria-pressed', String(!sub)); }
    var price = sub ? SUB_PRICE_TEXT : ONCE_PRICE_TEXT;
    for (var i = 0; i < ctaPriceEls.length; i++) ctaPriceEls[i].textContent = price;
  }
  function renderQty(){
    if (qtyEl) qtyEl.textContent = String(state.qty);
  }
  function renderBag(){
    var label = String(state.bag);
    for (var i = 0; i < bagLabelEls.length; i++) bagLabelEls[i].textContent = label;
  }
  function flash(text){
    // toast markup lives in the footer group (sections/landing-footer.liquid),
    // which Dawn renders after content_for_layout — i.e. after this section's
    // own <script> runs. Elements looked up once at load time would still be
    // null here, so look them up lazily on each call instead of caching them.
    var toastEl = document.getElementById('toast');
    var toastTextEl = document.getElementById('toastText');
    var toastBagEl = document.getElementById('toastBagLabel');
    if (!toastEl || !toastTextEl || !toastBagEl) return;
    if (toastTimer) clearTimeout(toastTimer);
    toastTextEl.textContent = text || 'Added to bag';
    toastBagEl.textContent = 'Bag · ' + state.bag;
    toastEl.classList.add('show');
    toastTimer = setTimeout(function(){ toastEl.classList.remove('show'); }, 2600);
  }
  function syncCartCount(){
    fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function(r){ return r.json(); })
      .then(function(cart){ state.bag = cart.item_count; renderBag(); })
      .catch(function(){});
  }
  function refreshCartDrawer(data){
    // Dawn's native <cart-drawer> refreshes itself via its own product-form
    // web component, which we don't use here (add-to-bag is a plain fetch to
    // /cart/add.js so it can run from multiple custom buttons). To keep the
    // drawer in sync instead of showing stale/empty contents until a full
    // page reload, we ask /cart/add.js to also render the cart-drawer section
    // (sections/cart-drawer.liquid, requested via the `sections` param) and
    // splice its HTML into #CartDrawer ourselves, then open the drawer.
    // Deliberately does NOT touch the 'cart-icon-bubble' section Dawn also
    // re-renders natively — this theme's own header bag icon (landing-header.liquid)
    // reuses that same id="cart-icon-bubble" for its own markup, and swapping its
    // innerHTML for Dawn's default bag-icon partial would wipe out our custom icon.
    if (!data || !data.sections || !data.sections['cart-drawer']) return;
    var drawerEl = document.querySelector('cart-drawer');
    var target = document.getElementById('CartDrawer');
    if (!drawerEl || !target) return;
    var parsed = new DOMParser().parseFromString(data.sections['cart-drawer'], 'text/html').querySelector('#CartDrawer');
    if (!parsed) return;
    target.innerHTML = parsed.innerHTML;
    // The "empty cart" layout (hidden header, squeezed grid) is driven by an
    // `is-empty` class on this outer <cart-drawer> element itself (see
    // component-cart-drawer.css: `cart-drawer.is-empty .drawer__inner {...}`),
    // set server-side when the drawer was first rendered with an empty cart.
    // The innerHTML swap above only replaces what's inside #CartDrawer, so it
    // never touches this outer element — remove the class here or the drawer
    // stays visually stuck in its empty state until a full page reload.
    drawerEl.classList.remove('is-empty');
    setTimeout(function(){
      var overlay = drawerEl.querySelector('#CartDrawer-Overlay');
      if (overlay) overlay.addEventListener('click', drawerEl.close.bind(drawerEl));
      drawerEl.open();
    });
  }
  function addToCart(e){
    // The header's "Add to bag" pill (data-header-cta) is reachable from every
    // page, including the PDP where a shopper may have already bumped the qty
    // stepper or switched to the subscription plan via [data-pdp-qty-*] /
    // [data-plan]. Those controls write into the same shared `state` object
    // this function normally reads from, so without this override a stray
    // click on the header pill would silently check out whatever plan/qty was
    // last left on the page instead of "add one box, right now" like the
    // button's own label promises. Force qty:1 and one-time (no selling_plan)
    // for this specific button; the main PDP/offer buy buttons (no
    // data-header-cta attribute) keep respecting state.plan/state.qty exactly
    // as before.
    var btn = e && e.currentTarget;
    var isHeaderCta = !!(btn && btn.hasAttribute('data-header-cta'));
    var sub = isHeaderCta ? false : state.plan === 'sub';
    var qty = isHeaderCta ? 1 : state.qty;
    if (sub && !HAS_SUB_PLAN) {
      flash('Subscriptions launch soon — try one box for now');
      return;
    }
    var item = { id: VARIANT_ID, quantity: qty };
    if (sub) item.selling_plan = SUB_PLAN_ID;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [item], sections: 'cart-drawer' })
    })
    .then(function(r){
      if (!r.ok) return r.json().then(function(e){ throw new Error((e && e.description) || 'Could not add to bag'); });
      return r.json();
    })
    .then(function(data){
      var msg;
      if (sub) {
        msg = 'Sleep · monthly subscription added';
      } else if (qty > 1) {
        msg = 'Sleep · ' + qty + ' boxes added';
      } else {
        msg = 'Sleep · 30 strips added';
      }
      flash(msg);
      syncCartCount();
      refreshCartDrawer(data);
    })
    .catch(function(err){
      flash(err.message || 'Something went wrong — try again');
    });
  }
  if (subCard) subCard.addEventListener('click', function(){ state.plan = 'sub'; renderPlan(); });
  if (onceCard) onceCard.addEventListener('click', function(){ state.plan = 'once'; renderPlan(); });
  if (qtyMinusBtn) qtyMinusBtn.addEventListener('click', function(){ if (state.qty > 1) { state.qty -= 1; renderQty(); } });
  if (qtyPlusBtn) qtyPlusBtn.addEventListener('click', function(){ if (state.qty < 10) { state.qty += 1; renderQty(); } });
  var addButtons = document.querySelectorAll('[data-add-to-bag]');
  for (var ai = 0; ai < addButtons.length; ai++) {
    addButtons[ai].addEventListener('click', addToCart);
  }
  if (document.getElementById('newsletterSuccess')) {
    setTimeout(function(){ flash('You’re on the list.'); }, 300);
  }
  renderPlan();
  renderQty();
  renderBag();
  syncCartCount();

  var faqs = document.querySelectorAll('[data-faq]');
  for (var fi = 0; fi < faqs.length; fi++) {
    faqs[fi].addEventListener('toggle', function(){
      var mark = this.querySelector('[data-faq-mark]');
      if (mark) mark.textContent = this.open ? '−' : '+';
    });
  }

  var headerEl = document.querySelector('[data-header]');
  if (headerEl) {
    var onScroll = function(){
      headerEl.style.boxShadow = window.scrollY > 40 ? '0 1px 22px rgba(11,11,12,.07)' : 'none';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  var menuToggle = document.querySelector('[data-menu-toggle]');
  var mobileNav = document.querySelector('[data-mobile-nav]');
  if (menuToggle && mobileNav) {
    var closeMenu = function(){
      mobileNav.classList.remove('open');
      menuToggle.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    var openMenu = function(){
      mobileNav.classList.add('open');
      menuToggle.classList.add('open');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    menuToggle.addEventListener('click', function(){
      if (mobileNav.classList.contains('open')) closeMenu(); else openMenu();
    });
    var mobileLinks = mobileNav.querySelectorAll('a');
    for (var mi = 0; mi < mobileLinks.length; mi++) mobileLinks[mi].addEventListener('click', closeMenu);
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeMenu(); });
    window.addEventListener('resize', function(){ if (window.innerWidth > 1024) closeMenu(); });
  }

  var SEL = '[data-reveal],[data-progress],[data-count],[data-tick],[data-race]';
  var done = new WeakSet();
  var raceOn = false;
  var raceTimers = [];
  var raceLoop = null;

  function finalText(el){
    var dec = parseInt(el.getAttribute('data-decimals') || '0', 10);
    var pre = el.getAttribute('data-prefix') || '';
    var suf = el.getAttribute('data-suffix') || '';
    var n = parseFloat(el.getAttribute('data-count'));
    return isNaN(n) ? el.textContent : pre + n.toFixed(dec) + suf;
  }

  function countUp(el){
    var raw = finalText(el);
    var target = parseFloat(el.getAttribute('data-count'));
    if (isNaN(target)) return;
    var dec = parseInt(el.getAttribute('data-decimals') || '0', 10);
    var pre = el.getAttribute('data-prefix') || '';
    var suf = el.getAttribute('data-suffix') || '';
    if (!rise) { el.textContent = raw; return; }
    var dur = 1100, t0 = performance.now();
    function step(now){
      var p = Math.min(1, (now - t0) / dur);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = pre + (target * eased).toFixed(dec) + suf;
      if (p < 1) requestAnimationFrame(step); else el.textContent = raw;
    }
    requestAnimationFrame(step);
  }

  function raceAt(fn, ms){ raceTimers.push(setTimeout(fn, ms)); }
  function raceCount(el, from, to, ms){
    if (!el) return;
    var t0 = performance.now();
    function tick(now){
      var q = Math.min(1, (now - t0) / ms);
      el.textContent = Math.round(from + (to - from) * (1 - Math.pow(1 - q, 3)));
      if (q < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  function runRace(el){
    raceTimers.forEach(clearTimeout);
    raceTimers = [];
    function q(s){ return el.querySelector(s); }
    var a = q('[data-runner="A"]'), b = q('[data-runner="B"]');
    var ia = q('[data-intact="A"]'), ib = q('[data-intact="B"]');
    var ca = q('[data-clock="A"]'), cb = q('[data-clock="B"]');
    if (!a || !b) return;
    if (!rise) {
      a.style.transition = 'none'; a.style.left = 'calc(100% - 44px)'; a.style.width = '44px';
      b.style.transition = 'none'; b.style.left = 'calc(100% - 104px)'; b.style.width = '104px';
      if (ia) ia.textContent = 35; if (ib) ib.textContent = 90;
      if (ca) ca.textContent = 60; if (cb) cb.textContent = 5;
      var arrivals = el.querySelectorAll('[data-arrive]');
      for (var k = 0; k < arrivals.length; k++) arrivals[k].style.opacity = '1';
      return;
    }
    [a, b].forEach(function(r){ r.style.transition = 'none'; r.style.left = '0px'; r.style.width = '116px'; });
    if (ia) ia.textContent = 100;
    if (ib) ib.textContent = 100;
    if (ca) ca.textContent = 0;
    if (cb) cb.textContent = 0;
    var arrA = q('[data-arrive="A"]'), arrB = q('[data-arrive="B"]');
    [arrA, arrB].forEach(function(x){ if (x) { x.style.transition = 'none'; x.style.opacity = '0'; } });
    raceAt(function(){ if (arrB) { arrB.style.transition = 'opacity .4s'; arrB.style.opacity = '1'; } }, 1400);
    raceAt(function(){ if (arrA) { arrA.style.transition = 'opacity .4s'; arrA.style.opacity = '1'; } }, 3700);
    raceAt(function(){
      b.style.transition = 'left 1.1s ' + EASE + ', width 1.1s ' + EASE;
      b.style.left = 'calc(100% - 104px)';
      b.style.width = '104px';
      raceCount(ib, 100, 90, 1100);
      raceCount(cb, 0, 5, 1100);
      a.style.transition = 'left 1.1s ' + EASE;
      a.style.left = '20%';
      raceCount(ca, 0, 60, 4200);
    }, 300);
    raceAt(function(){
      a.style.transition = 'left .9s ' + EASE + ', width .9s ' + EASE;
      a.style.left = '46%';
      a.style.width = '88px';
      raceCount(ia, 100, 75, 900);
    }, 1500);
    raceAt(function(){
      a.style.transition = 'left 1.2s ' + EASE + ', width 1.2s ' + EASE;
      a.style.left = 'calc(100% - 44px)';
      a.style.width = '44px';
      raceCount(ia, 75, 35, 1200);
    }, 2500);
  }
  function startRace(el){
    if (raceOn) return;
    raceOn = true;
    var run = function(){ runRace(el); };
    run();
    raceLoop = setInterval(run, 8000);
  }

  function target(el){
    return el.hasAttribute('data-progress') ? '100%' : '0%';
  }

  function prime(el, vh){
    if (el.hasAttribute('data-progress')) { el.style.transition = 'none'; el.style.width = '0%'; }
    if (el.hasAttribute('data-tick') && rise) { el.style.display = 'inline-block'; el.style.opacity = '0'; el.style.transform = 'scale(.6)'; }
    if (el.hasAttribute('data-reveal') && el.getBoundingClientRect().top > vh * 0.9) {
      el.style.opacity = '0';
      if (rise) el.style.transform = 'translateY(14px)';
    }
  }

  function activate(el){
    done.add(el);
    if (el.hasAttribute('data-reveal')) {
      el.style.transition = 'opacity .7s ' + EASE + ', transform .7s ' + EASE;
      el.style.opacity = '1';
      el.style.transform = 'none';
    }
    if (el.hasAttribute('data-progress')) {
      var t = target(el);
      el.style.transition = 'width 1.2s ' + EASE;
      requestAnimationFrame(function(){ el.style.width = t; });
    }
    if (el.hasAttribute('data-count')) countUp(el);
    if (el.hasAttribute('data-race')) startRace(el);
    if (el.hasAttribute('data-tick')) {
      var row = el.parentElement && el.parentElement.parentElement;
      var sibs = row ? Array.prototype.slice.call(row.querySelectorAll('[data-tick]')) : [el];
      sibs.forEach(function(t, i){
        setTimeout(function(){
          done.add(t);
          t.style.transition = 'opacity .35s ' + EASE + ', transform .35s ' + EASE;
          t.style.opacity = '1';
          t.style.transform = 'none';
        }, i * 70);
      });
    }
  }

  var vh = window.innerHeight;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      activate(e.target);
    });
  }, { threshold: 0.2, rootMargin: '0px 0px -6% 0px' });

  var targets = document.querySelectorAll(SEL);
  for (var ti = 0; ti < targets.length; ti++) {
    prime(targets[ti], vh);
    io.observe(targets[ti]);
  }
  setTimeout(function(){
    var all = document.querySelectorAll(SEL);
    for (var i = 0; i < all.length; i++) { if (!done.has(all[i])) activate(all[i]); }
  }, 4500);
})();
</script>

{% schema %}
{
  "name": "Landing scripts",
  "tag": "section",
  "settings": [{ "type": "product", "id": "product", "label": "Product" }],
  "presets": [{ "name": "Landing scripts" }]
}
{% endschema %}
