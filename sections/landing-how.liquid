<section id="how" class="how-section">
<div class="how-wrap">
<div data-reveal class="how-eyebrow">{{ section.settings.eyebrow }}</div>
<h2 data-reveal class="how-heading">{{ section.settings.heading }}</h2>
<p data-reveal class="how-subheading">{{ section.settings.subheading }}</p>

<div data-reveal class="how-progress-track"><div data-progress class="how-progress-fill"></div></div>
<div class="how-steps-grid">
{%- for block in section.blocks -%}
<div data-reveal class="hov-step how-step" {{ block.shopify_attributes }}>
<div class="how-step-meta"><span>{%- if forloop.index < 10 -%}0{{ forloop.index }}{%- else -%}{{ forloop.index }}{%- endif -%}</span><span>{{ block.settings.time }}</span></div>
<h3 class="how-step-title">{{ block.settings.title }}</h3>
<p class="how-step-text">{{ block.settings.text }}</p>
</div>
{%- endfor -%}
</div>

<div class="how-images-row">
<div data-reveal class="how-image-wide">
{%- if section.settings.image_wide != blank -%}
<img src="{{ section.settings.image_wide | image_url: width: 1400 }}" alt="{{ section.settings.image_wide.alt | escape }}" class="how-image-img" loading="lazy" width="1400" height="788">
{%- else -%}
<div class="img-slot"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg><span>{{ section.settings.image_wide_placeholder_text }}</span></div>
{%- endif -%}
</div>
<div data-reveal class="how-image-square">
{%- if section.settings.image_square != blank -%}
<img src="{{ section.settings.image_square | image_url: width: 900 }}" alt="{{ section.settings.image_square.alt | escape }}" class="how-image-img" loading="lazy" width="900" height="900">
{%- else -%}
<div class="img-slot"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg><span>{{ section.settings.image_square_placeholder_text }}</span></div>
{%- endif -%}
</div>
</div>
</div>
</section>

{% schema %}
{
  "name": "Landing how",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 — The ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open. Place. Dissolve." },
    { "type": "textarea", "id": "subheading", "label": "Intro paragraph", "default": "Ten minutes before bedtime. One strip out of a single-dose sachet, onto your tongue. Then put your phone down." },
    { "type": "image_picker", "id": "image_wide", "label": "Wide image (16:9)" },
    { "type": "text", "id": "image_wide_placeholder_text", "label": "Wide image placeholder caption", "default": "Macro — strip on the tongue, mid-dissolve" },
    { "type": "image_picker", "id": "image_square", "label": "Square image (1:1)" },
    { "type": "text", "id": "image_square_placeholder_text", "label": "Square image placeholder caption", "default": "Real bedroom, low light, 9:16 crop ok" }
  ],
  "blocks": [
    { "type": "step", "name": "Ritual step", "settings": [ { "type": "text", "id": "time", "label": "Time stamp", "default": "0:00" }, { "type": "text", "id": "title", "label": "Title", "default": "Open" }, { "type": "textarea", "id": "text", "label": "Text", "default": "Tear the sachet. One strip, one dose — nothing to measure, nothing to count." } ] }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Landing how",
      "blocks": [
        { "type": "step", "settings": { "time": "0:00", "title": "Open", "text": "Tear the sachet. One strip, one dose — nothing to measure, nothing to count." } },
        { "type": "step", "settings": { "time": "0:05", "title": "Place", "text": "On your tongue. It holds itself there — no water, no chewing, no aftertaste to chase." } },
        { "type": "step", "settings": { "time": "0:60", "title": "Dissolve", "text": "Gone in under a minute, absorbed on the way. Strip2Cell is the delivery; the actives are the dose." } }
      ]
    }
  ]
}
{% endschema %}
