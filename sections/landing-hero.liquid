{%- liquid
  assign product = all_products[section.settings.product]
  assign variant = product.selected_or_first_available_variant
-%}
<section id="top" class="hero-section">
<div class="hero-grid">
<div>
<div data-reveal class="hero-eyebrow"><span class="hero-eyebrow-line"></span>{{ section.settings.eyebrow }}</div>
<h1 data-reveal class="hero-heading">{{ section.settings.heading | newline_to_br }}</h1>
<div data-reveal class="hero-body">{{ section.settings.body }}</div>
<div data-reveal class="hero-cta-row">
<button type="button" data-add-to-bag class="hov-dark hov-dark-sm hero-cta-primary">{{ section.settings.cta_label }} · S${{ variant.price | money | remove: '$' }}</button>
<a href="{{ section.settings.secondary_link }}" class="hov-outline hero-cta-secondary">{{ section.settings.secondary_label }} <span class="hero-cta-arrow">→</span></a>
</div>
<div data-reveal class="hero-stats-grid">
{%- for block in section.blocks -%}
<div class="hero-stat-tile" {{ block.shopify_attributes }}><div class="hero-stat-value"><span data-count="{{ block.settings.value }}" data-decimals="{{ block.settings.decimals }}" data-prefix="{{ block.settings.prefix }}" data-suffix="{{ block.settings.suffix }}">{{ block.settings.prefix }}{{ block.settings.value }}{{ block.settings.suffix }}</span></div><div class="hero-stat-label">{{ block.settings.label }}</div></div>
{%- endfor -%}
</div>
</div>
<div class="hero-visual">
<div class="hero-visual-frame">
{%- if section.settings.image != blank -%}
<img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" class="hero-visual-img" loading="lazy" width="900" height="1125">
{%- else -%}
<div class="img-slot"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg><span>{{ section.settings.image_placeholder_text }}</span></div>
{%- endif -%}
<div class="hero-visual-overlay">
<div class="hero-visual-overlay-row">
<span>Dissolve</span><span>0:60 → dissolved</span>
</div>
<div class="hero-visual-bar-track"><div class="hero-visual-bar-fill"></div></div>
</div>
</div>
<div class="hero-badge">{{ section.settings.badge }}</div>
</div>
</div>
</section>

{% schema %}
{
  "name": "Landing hero",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Used for the live price shown in the Add to bag button" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Strip2Cell sleep film · Singapore" },
    { "type": "textarea", "id": "heading", "label": "Heading (line breaks preserved)", "default": "60 seconds\non your\ntongue." },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>One strip. No water, no swallowing, no waiting. It dissolves on your tongue and our Strip2Cell delivery system carries the actives straight into your bloodstream — up to 90%* of the dose, skipping the gut and the liver entirely.</p>" },
    { "type": "text", "id": "cta_label", "label": "Add-to-bag button label", "default": "Add to bag" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "See the science" },
    { "type": "text", "id": "secondary_link", "label": "Secondary link (anchor or URL)", "default": "#science" },
    { "type": "text", "id": "badge", "label": "Floating badge text", "default": "Melatonin-free" },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "image_placeholder_text", "label": "Placeholder caption (shown until an image is added)", "default": "Pack shot on white — Dr.Strips+ Sleep, 30 strips" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat tile",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "60" },
        { "type": "number", "id": "decimals", "label": "Decimal places", "default": 0 },
        { "type": "text", "id": "prefix", "label": "Prefix" },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "s" },
        { "type": "text", "id": "label", "label": "Label", "default": "Dissolve" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Landing hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "60", "suffix": "s", "label": "Dissolve" } },
        { "type": "stat", "settings": { "value": "90", "prefix": "≤", "suffix": "%", "label": "Absorbed*" } },
        { "type": "stat", "settings": { "value": "0", "suffix": "g", "label": "Sugar" } },
        { "type": "stat", "settings": { "value": "30", "label": "Strips / box" } }
      ]
    }
  ]
}
{% endschema %}
