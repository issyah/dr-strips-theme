{% comment %}
  Section: Product page — outcomes / proof timeline — landing-pdp-outcomes.liquid
{% endcomment %}
<section class="pdpo-section">
  <div class="pdpo-container">
    <div class="pdpo-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pdpo-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pdpo-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pdpo-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="pdpo-timeline">
      <div class="pdpo-axis" aria-hidden="true"><i></i></div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="pdpo-item pdpo-lift-{{ block.settings.lift }}" {{ block.shopify_attributes }}>
            <div class="pdpo-card">
              <div class="pdpo-value">{{ block.settings.value }}</div>
              <div class="pdpo-label">{{ block.settings.label }}</div>
            </div>
            <div class="pdpo-stem" aria-hidden="true"><i></i></div>
            <div class="pdpo-dot" aria-hidden="true"><i></i></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="pdpo-footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PDP — Outcomes",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built on what the science actually supports"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "No clinical trial claims. Just the real numbers behind the formula, the format, and how it's dosed."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "*Absorption ceiling is based on ingredient bioavailability data, not a measurement of any one person on any one night."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "60s"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Time to dissolve on your tongue"
        },
        {
          "type": "select",
          "id": "lift",
          "label": "Height on timeline",
          "options": [
            { "value": "low", "label": "Low" },
            { "value": "medium", "label": "Medium" },
            { "value": "high", "label": "High" },
            { "value": "highest", "label": "Highest" }
          ],
          "default": "medium"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "PDP — Outcomes",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "60s",
            "label": "Time to dissolve on your tongue",
            "lift": "high"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "≤90%*",
            "label": "Of the dose absorbed, skipping digestion",
            "lift": "low"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "0mg",
            "label": "Synthetic melatonin in the formula",
            "lift": "highest"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "5",
            "label": "Active ingredients, each dosed on the box",
            "lift": "medium"
          }
        }
      ]
    }
  ]
}
{% endschema %}
