{% comment %}
  Section: Product page — key ingredients preview — landing-pdp-ingredients.liquid
{% endcomment %}
<section id="ingredients" class="pdpi-section">
<div class="pdpi-wrap">
<div data-reveal class="pdpi-eyebrow">{{ section.settings.eyebrow }}</div>
<div class="pdpi-head-row">
<h2 data-reveal class="pdpi-heading">{{ section.settings.heading }}</h2>
<p data-reveal class="pdpi-subheading">{{ section.settings.subheading }}</p>
</div>

<div class="pdpi-grid">
{%- for block in section.blocks -%}
<div data-reveal class="hov-ingredient pdpi-card" {{ block.shopify_attributes }}>
<div class="pdpi-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c-4-2-7-6-7-10a7 7 0 0 1 14 0c0 4-3 8-7 10Z"></path><path d="M12 17V9"></path></svg></div>
<div class="pdpi-name">{{ block.settings.name }}</div>
<p class="pdpi-text">{{ block.settings.text }}</p>
</div>
{%- endfor -%}
</div>

<a href="{{ section.settings.link_url }}" class="pdpi-link">{{ section.settings.link_label }}</a>
</div>
</section>

{% schema %}
{
  "name": "PDP — Ingredients",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "04 — Key ingredients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's actually in the strip." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Three of the five actives — see the full breakdown for exact doses and the reasoning behind each one." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the complete ingredient breakdown →" },
    { "type": "text", "id": "link_url", "label": "Link URL", "default": "/pages/ingredient-library" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "PDP — Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Pistachio extract", "text": "One of the richest natural sources of phytomelatonin — the plant-derived form of the sleep signal your body already reads." } },
        { "type": "ingredient", "settings": { "name": "GABA", "text": "Works with your nervous system's own braking signal, associated with quieting a racing mind before sleep." } },
        { "type": "ingredient", "settings": { "name": "Valerian root extract", "text": "Traditionally used to shorten the time it takes to fall asleep." } }
      ]
    }
  ]
}
{% endschema %}
