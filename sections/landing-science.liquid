{% comment %}
  Section: The mechanism (science) — landing-science.liquid
{% endcomment %}
<section id="science" style="background:#0B0B0C;color:#fff;padding:clamp(80px,9vw,148px) clamp(20px,4vw,40px);position:relative;overflow:hidden">
<div style="position:absolute;top:-30%;left:50%;width:900px;height:900px;transform:translateX(-50%);background:radial-gradient(circle,rgba(255,255,255,.06),transparent 62%);pointer-events:none"></div>
<div style="max-width:1200px;margin:0 auto;position:relative">
<div data-reveal style="font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#8A8C91">{{ section.settings.eyebrow_label }}</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(28px,4vw,64px);margin-top:26px;align-items:start">
<h2 data-reveal style="margin:0;font-size:clamp(34px,4.4vw,62px);line-height:1.0;letter-spacing:-.04em;font-weight:500;color:#fff">{{ section.settings.heading }}</h2>
<div data-reveal style="margin:0;font-size:17px;line-height:1.7;color:#A9ABAF;max-width:520px">{{ section.settings.body_text }}</div>
</div>

<div data-reveal data-race style="margin-top:clamp(48px,6vw,88px);border:1px solid #232427;border-radius:16px;padding:clamp(22px,3vw,40px);background:#0F1012"><div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:baseline"><span style="font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:#8A8C91">{{ section.settings.race_caption }}</span><span style="font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075">{{ section.settings.race_legend }}</span></div><div style="margin-top:30px;display:grid;gap:26px"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px 24px;align-items:center"><div style="font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#fff">{{ section.settings.race_top_label }}</div><div style="grid-column:span 2;min-width:280px;display:flex;gap:18px;align-items:center"><div style="flex:1;position:relative;height:54px"><div style="position:absolute;top:26px;left:0;right:0;height:1px;background:#232427"></div><div data-runner="B" style="position:absolute;top:14px;left:0;height:26px;width:116px;background:#FFFFFF;border-radius:4px"></div><div style="position:absolute;top:8px;right:0;bottom:8px;width:1px;background:#2C2D30"></div><div data-arrive="B" style="position:absolute;top:-7px;right:0;font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#FFFFFF">{{ section.settings.race_top_arrival }}</div></div><div style="width:82px;text-align:right;flex:none"><div style="font-family:'Geist Mono',monospace;font-size:30px;letter-spacing:-.03em;color:#fff"><span data-intact="B">{{ section.settings.race_top_intact }}</span></div><div style="font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075;margin-top:4px">of 100 intact</div></div></div></div><div style="height:1px;background:#232427"></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px 24px;align-items:center"><div style="font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#8A8C91">{{ section.settings.race_bottom_label }}</div><div style="grid-column:span 2;min-width:280px;display:flex;gap:18px;align-items:center"><div style="flex:1;position:relative;height:54px"><div style="position:absolute;top:26px;left:0;right:0;height:1px;background:#232427"></div><div style="position:absolute;top:4px;left:20%;width:26%;bottom:4px;border-left:1px dashed #2C2D30;border-right:1px dashed #2C2D30"></div><div style="position:absolute;top:-6px;left:calc(20% + 6px);font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075">Gut</div><div style="position:absolute;top:4px;left:46%;width:34%;bottom:4px;border-left:1px dashed #2C2D30;border-right:1px dashed #2C2D30"></div><div style="position:absolute;top:-6px;left:calc(46% + 6px);font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075">Liver</div><div data-runner="A" style="position:absolute;top:14px;left:0;height:26px;width:116px;background:#A9ABAF;border-radius:4px"></div><div style="position:absolute;top:8px;right:0;bottom:8px;width:1px;background:#2C2D30"></div><div data-arrive="A" style="position:absolute;top:-7px;right:0;font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#8A8C91">{{ section.settings.race_bottom_arrival }}</div></div><div style="width:82px;text-align:right;flex:none"><div style="font-family:'Geist Mono',monospace;font-size:30px;letter-spacing:-.03em;color:#A9ABAF"><span data-intact="A">{{ section.settings.race_bottom_intact }}</span></div><div style="font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#6E7075;margin-top:4px">of 100 intact</div></div></div></div></div><div style="display:flex;flex-wrap:wrap;gap:34px;margin-top:26px;border-top:1px solid #232427;padding-top:22px"><div><div style="font-family:'Geist Mono',monospace;font-size:38px;letter-spacing:-.03em;color:#fff"><span data-clock="B">{{ section.settings.race_top_minutes }}</span><span style="font-size:16px;color:#8A8C91"> min</span></div><div style="font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:#8A8C91;margin-top:6px">Strip2Cell arrival</div></div><div><div style="font-family:'Geist Mono',monospace;font-size:38px;letter-spacing:-.03em;color:#A9ABAF"><span data-clock="A">{{ section.settings.race_bottom_minutes }}</span><span style="font-size:16px;color:#6E7075"> min</span></div><div style="font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:#8A8C91;margin-top:6px">Pill arrival, two gates later</div></div></div><p style="margin:26px 0 0;font-size:13px;line-height:1.6;color:#6E7075;max-width:660px">{{ section.settings.race_footnote }}</p></div>
</div>
</section>

{% schema %}
{
  "name": "Landing Science",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_label",
      "label": "Eyebrow label",
      "default": "02 — The mechanism"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Swallow it, and your liver gets first pick."
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Anything you swallow goes gut first, liver second, bloodstream last. First-pass metabolism breaks down a large share of the dose before it ever reaches your brain. That is not a bad formula — it is the route.</p><p>Strip2Cell skips the queue. The film dissolves on your tongue and the actives cross the mucosal tissue lining your mouth, straight into the capillaries beneath it.</p>"
    },
    {
      "type": "text",
      "id": "race_caption",
      "label": "Race chart caption",
      "default": "Both doses leave at once"
    },
    {
      "type": "text",
      "id": "race_legend",
      "label": "Race chart legend",
      "default": "Bar length = dose still intact · each lane ends at its own arrival"
    },
    {
      "type": "text",
      "id": "race_top_label",
      "label": "Race chart — top lane label",
      "default": "Strip2Cell film"
    },
    {
      "type": "text",
      "id": "race_top_arrival",
      "label": "Race chart — top lane arrival label",
      "default": "Arrives · 5 min"
    },
    {
      "type": "text",
      "id": "race_top_intact",
      "label": "Race chart — top lane intact number",
      "default": "90"
    },
    {
      "type": "text",
      "id": "race_top_minutes",
      "label": "Race chart — top lane minutes number",
      "default": "5"
    },
    {
      "type": "text",
      "id": "race_bottom_label",
      "label": "Race chart — bottom lane label",
      "default": "Swallowed pill"
    },
    {
      "type": "text",
      "id": "race_bottom_arrival",
      "label": "Race chart — bottom lane arrival label",
      "default": "Arrives · 60 min"
    },
    {
      "type": "text",
      "id": "race_bottom_intact",
      "label": "Race chart — bottom lane intact number",
      "default": "35"
    },
    {
      "type": "text",
      "id": "race_bottom_minutes",
      "label": "Race chart — bottom lane minutes number",
      "default": "60"
    },
    {
      "type": "textarea",
      "id": "race_footnote",
      "label": "Race chart footnote",
      "default": "*Up to 90% is the ceiling of the oral-mucosal route Strip2Cell uses, for actives suited to it. Not a formula-wide figure. ~35% is a typical figure for an equivalent swallowed dose after first-pass metabolism. Timings are illustrative of the route, not a clinical measurement."
    }
  ],
  "presets": [
    {
      "name": "Landing Science"
    }
  ]
}
{% endschema %}