{{ 'section-press-marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #PressMarquee-{{ section.id }} .press-marquee__track {
    --press-marquee-duration: {{ section.settings.speed }}s;
  }
{%- endstyle -%}

<div class="press-marquee{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  <div class="press-marquee__wrapper color-{{ section.settings.color_scheme }} gradient content-container content-container--full-width section-{{ section.id }}-padding">
    <div
      id="PressMarquee-{{ section.id }}"
      class="press-marquee__inner page-width{% if section.settings.direction == 'right' %} press-marquee--direction-right{% endif %}{% if section.settings.pause_on_hover %} press-marquee--pause-on-hover{% endif %}"
    >
      {%- if section.settings.label != blank -%}
        <p class="press-marquee__label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="press-marquee__viewport">
          <div class="press-marquee__track">
            <div class="press-marquee__group">
              {%- for block in section.blocks -%}
                {%- render 'press-marquee-item', block: block, duplicate: false -%}
              {%- endfor -%}
            </div>
            <div class="press-marquee__group" aria-hidden="true">
              {%- for block in section.blocks -%}
                {%- render 'press-marquee-item', block: block, duplicate: true -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Press marquee",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label text",
      "default": "As seen around Singapore soon"
    },
    {
      "type": "select",
      "id": "speed",
      "label": "Scroll speed",
      "options": [
        {
          "value": "20",
          "label": "Fast"
        },
        {
          "value": "35",
          "label": "Medium"
        },
        {
          "value": "55",
          "label": "Slow"
        }
      ],
      "default": "35"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo_item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "default": "Publication name"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge letter",
          "info": "Defaults to the first letter of the name if left blank."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press marquee",
      "blocks": [
        {
          "type": "logo_item",
          "settings": {
            "label": "The Morning Standard"
          }
        },
        {
          "type": "logo_item",
          "settings": {
            "label": "City Pulse"
          }
        },
        {
          "type": "logo_item",
          "settings": {
            "label": "Wellness Weekly"
          }
        },
        {
          "type": "logo_item",
          "settings": {
            "label": "Night Owl Journal"
          }
        }
      ]
    }
  ]
}
{% endschema %}
