<section class="news-section">
<div data-reveal class="news-container">
<div>
<h3 class="news-heading">{{ section.settings.heading }}</h3>
<p class="news-text">{{ section.settings.text }}</p>
</div>
{% form 'customer', id: 'newsletterForm', class: 'newsletter-form' %}{% if form.posted_successfully? %}<input type="hidden" id="newsletterSuccess" value="1">{% endif %}
<input type="hidden" name="contact[tags]" value="newsletter,dr-strips-sleep-landing">
<div class="news-form-row">
<input type="email" name="contact[email]" required placeholder="{{ section.settings.email_placeholder }}" class="hov-input news-input">
<button type="submit" class="hov-dark news-button">{{ section.settings.button_label }}</button>
</div>
{% endform %}
</div>
</section>

{% schema %}
{
  "name": "Landing newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the delivery science, once a month." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "What we tested, what we shipped, and never the word \"biohack.\" One email, unsubscribe any time." },
    { "type": "text", "id": "email_placeholder", "label": "Email field placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join" }
  ],
  "presets": [
    { "name": "Landing newsletter" }
  ]
}
{% endschema %}
