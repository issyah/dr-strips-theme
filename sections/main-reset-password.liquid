{% comment %}
  Section: Reset password — main-reset-password.liquid
  Renders at /account/reset/{id}/{token} (the link from a password-reset email).
{% endcomment %}
<section class="acct-section">
<div class="acct-auth-card">
<h1 class="acct-auth-heading">Reset your password</h1>
<p class="acct-auth-subtext">Enter a new password below.</p>
{% form 'reset_customer_password' %}
{%- if form.errors -%}
<p class="acct-form-error">{{ form.errors | default_errors }}</p>
{%- endif -%}
<div class="acct-field">
<label for="ResetPassword">New password</label>
<input type="password" name="customer[password]" id="ResetPassword" class="hov-input acct-input" autocomplete="new-password" required>
</div>
<div class="acct-field">
<label for="ResetPasswordConfirm">Confirm password</label>
<input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" class="hov-input acct-input" autocomplete="new-password" required>
</div>
<button type="submit" class="acct-submit">Reset password</button>
{% endform %}
</div>
</section>

{% schema %}
{
  "name": "Reset password",
  "tag": "section"
}
{% endschema %}
