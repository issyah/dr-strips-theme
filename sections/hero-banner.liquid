{{ 'section-hero-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #HeroBanner-{{ section.id }} .hero-banner__product {
    --hero-banner-rotate: {{ section.settings.image_rotation }}deg;
    --hero-banner-image-width: {{ section.settings.image_width }}%;
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  id="HeroBanner-{{ section.id }}"
  class="hero-banner color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  {%- if section.settings.background_image != blank -%}
    <div class="hero-banner__backdrop" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 3000
        | image_tag: sizes: '100vw', widths: '750, 1100, 1500, 2000, 3000', fetchpriority: fetch_priority
      }}
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="hero-banner__inner">
      {%- if section.settings.wordmark != blank -%}
        <p class="hero-banner__wordmark">{{ section.settings.wordmark | escape }}</p>
      {%- endif -%}

      <div class="hero-banner__stage">
        {%- if section.settings.heading != blank -%}
          <h2 class="hero-banner__heading">{{ section.settings.heading | newline_to_br }}</h2>
        {%- endif -%}

        {%- if section.settings.image != blank -%}
          <div class="hero-banner__product">
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag: sizes: '(min-width: 750px) 30vw, 45vw', widths: '250, 400, 600, 900, 1200', fetchpriority: fetch_priority
            }}
          </div>
        {%- else -%}
          <div class="hero-banner__product hero-banner__product--placeholder">
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.caption != blank -%}
        <p class="hero-banner__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark text",
      "default": "novastrips"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Each line becomes its own stacked row.",
      "default": "Sleep\nDeeper."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Moon Melt · Sleep Oral Strips"
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Image width",
      "default": 24
    },
    {
      "type": "range",
      "id": "image_rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "unit": "°",
      "label": "Image rotation",
      "default": -8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Decorative background image",
      "info": "Optional. Displays full-bleed behind the content."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
