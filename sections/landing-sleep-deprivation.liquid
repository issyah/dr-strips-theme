{% comment %}
  Section: Why Sleep Matters page — 03 What happens when you don't sleep enough — landing-sleep-deprivation.liquid
{% endcomment %}
<section id="deprivation" class="wsmd-section">
<div class="wsmd-container">
<div data-reveal class="wsmd-eyebrow">{{ section.settings.eyebrow }}</div>
<div class="wsmd-intro-grid">
<h2 data-reveal class="wsmd-heading">{{ section.settings.heading }}</h2>
<div>
<p data-reveal class="wsmd-body">{{ section.settings.body_1 }}</p>
<p data-reveal class="wsmd-body--second">{{ section.settings.body_2 }}</p>
</div>
</div>

<div class="wsmd-cards">
{%- for block in section.blocks -%}
<div data-reveal class="hov-card wsmd-card" {{ block.shopify_attributes }}>
<div class="wsmd-card-index">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
<div class="wsmd-card-title">{{ block.settings.title }}</div>
</div>
{%- endfor -%}
</div>

<div data-reveal class="wsmd-callout">
<div class="wsmd-callout-label">{{ section.settings.callout_label }}</div>
<p class="wsmd-callout-text">{{ section.settings.callout_text }}</p>
</div>

<p data-reveal class="wsmd-disclaimer">{{ section.settings.disclaimer }}</p>
</div>
</section>

{% schema %}
{
  "name": "Sleep — Deprivation",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 — What happens when you don't sleep enough" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One short night can feel manageable." },
    { "type": "textarea", "id": "body_1", "label": "Body text 1", "default": "You might feel slower. Less focused. More irritable. More dependent on caffeine. But sleep loss isn't only about how tired you feel." },
    { "type": "textarea", "id": "body_2", "label": "Body text 2", "default": "When insufficient sleep becomes a pattern, research has associated inadequate sleep with changes across several areas of health and function:" },
    { "type": "text", "id": "callout_label", "label": "Callout label", "default": "The tricky part" },
    { "type": "textarea", "id": "callout_text", "label": "Callout text", "default": "You don't always notice the change immediately. You can become accustomed to functioning below your best — which is why sleep shouldn't only be treated as something to think about when you're exhausted. It's something worth protecting before you reach that point." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "This page provides general education on sleep science and is not medical advice. It does not diagnose, treat, cure or prevent any disease. If sleep problems are persistent or affecting your daily life, speak to a doctor." }
  ],
  "blocks": [
    {
      "type": "effect_card",
      "name": "Effect card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Sleep — Deprivation",
      "blocks": [
        { "type": "effect_card", "settings": { "title": "Attention" } },
        { "type": "effect_card", "settings": { "title": "Cognitive performance" } },
        { "type": "effect_card", "settings": { "title": "Mood" } },
        { "type": "effect_card", "settings": { "title": "Metabolic health" } },
        { "type": "effect_card", "settings": { "title": "Immune function" } }
      ]
    }
  ]
}
{% endschema %}
