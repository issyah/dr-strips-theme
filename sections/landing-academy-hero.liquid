{% comment %}
  Section: Sleep Academy hub — hero — landing-academy-hero.liquid
  Reused in compact mode (acy_compact = true) as a lightweight heading for the
  native Blog listing template (templates/blog.json), so any blog on this theme
  gets a branded heading with zero extra setup — falls back to {{ blog.title }}
  when no heading override is set.
{% endcomment %}
<section id="top" class="acy-hero-section{% if section.settings.compact %} acy-compact{% endif %}">
<div class="acy-wrap">
<div data-reveal class="acy-eyebrow"><span class="acy-eyebrow-line"></span>{{ section.settings.eyebrow }}</div>
<h1 data-reveal class="acy-heading">
{%- if section.settings.heading != blank -%}{{ section.settings.heading }}{%- else -%}{{ blog.title | default: 'Sleep Academy' }}{%- endif -%}
</h1>
{%- if section.settings.subheading != blank -%}
<p data-reveal class="acy-subheading">{{ section.settings.subheading }}</p>
{%- endif -%}
{%- if section.settings.lead != blank -%}
<p data-reveal class="acy-lead">{{ section.settings.lead }}</p>
{%- endif -%}
{%- unless section.settings.compact -%}
<div data-reveal class="acy-no-list">
{%- if section.settings.no_1 != blank -%}<span class="acy-no-item">{{ section.settings.no_1 }}</span>{%- endif -%}
{%- if section.settings.no_2 != blank -%}<span class="acy-no-item">{{ section.settings.no_2 }}</span>{%- endif -%}
{%- if section.settings.no_3 != blank -%}<span class="acy-no-item">{{ section.settings.no_3 }}</span>{%- endif -%}
</div>
{%- if section.settings.closing_line != blank -%}
<p data-reveal class="acy-closing">{{ section.settings.closing_line }}</p>
{%- endif -%}
{%- endunless -%}
</div>
</section>

{% schema %}
{
  "name": "Academy — Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Learn — Sleep Academy" },
    { "type": "text", "id": "heading", "label": "Heading (blank = blog title)", "default": "The Dr.Strips+ Sleep Academy" },
    { "type": "text", "id": "subheading", "label": "Subheading" , "default": "Understand sleep. Build better nights." },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "Sleep is one of the most important parts of your daily life — yet most of us spend remarkably little time actually understanding it. The Sleep Academy exists to change that: a growing library of clear, practical articles on how sleep works, why it matters, and how to build a routine that actually holds up on a busy week." },
    { "type": "checkbox", "id": "compact", "label": "Compact mode (used on the Blog listing template)", "default": false },
    { "type": "text", "id": "no_1", "label": "\"No\" list — item 1", "default": "No fear." },
    { "type": "text", "id": "no_2", "label": "\"No\" list — item 2", "default": "No miracle hacks." },
    { "type": "text", "id": "no_3", "label": "\"No\" list — item 3", "default": "No sensational headlines." },
    { "type": "textarea", "id": "closing_line", "label": "Closing line", "default": "Just useful, evidence-informed information about sleep, explained in language that makes sense." }
  ],
  "presets": [{ "name": "Academy — Hero" }]
}
{% endschema %}
