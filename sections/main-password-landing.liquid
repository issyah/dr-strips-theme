    <div class="pwl-eyebrow">
      <span class="pwl-eyebrow-rule"></span>
      {{ section.settings.eyebrow }}
      <span class="pwl-eyebrow-rule"></span>
    </div>

    <h1 class="pwl-heading">{{ section.settings.heading }}</h1>
    <p class="pwl-intro">{{ section.settings.subheading }}</p>

    <div class="pwl-forms">
      <div class="pwl-card">
        <div class="pwl-card-label">Get early access</div>
        <h2 class="pwl-card-title">{{ section.settings.email_card_title }}</h2>
        <p class="pwl-card-copy">{{ section.settings.email_card_copy }}</p>
        {%- form 'customer', class: 'pwl-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,password-page">
          <div class="pwl-field-row">
            <input
              type="email"
              name="contact[email]"
              class="pwl-input"
              placeholder="{{ section.settings.email_placeholder }}"
              value="{{ form.email }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              aria-label="Email"
              required
            >
            <button type="submit" class="pwl-btn">{{ section.settings.email_button_label }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="pwl-msg pwl-msg--success" tabindex="-1" autofocus>Thanks — we'll email you the moment we launch.</p>
          {%- elsif form.errors -%}
            <p class="pwl-msg pwl-msg--error" tabindex="-1" autofocus>{{ form.errors.messages['form'] | default: "Please enter a valid email address." }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="pwl-card">
        <div class="pwl-card-label">Have a password?</div>
        <h2 class="pwl-card-title">{{ section.settings.password_card_title }}</h2>
        <p class="pwl-card-copy">{{ section.settings.password_card_copy }}</p>
        {%- form 'storefront_password', class: 'pwl-form' -%}
          <div class="pwl-field-row">
            <input
              type="password"
              name="password"
              id="Password"
              class="pwl-input"
              placeholder="{{ section.settings.password_placeholder }}"
              autocomplete="current-password"
              aria-label="Password"
              {%- if form.errors %} aria-invalid="true"{% endif %}
              required
            >
            <button type="submit" class="pwl-btn">{{ section.settings.password_button_label }}</button>
          </div>
          {%- if form.errors -%}
            <p class="pwl-msg pwl-msg--error" tabindex="-1" autofocus>{{ 'general.password_page.login_form_error' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password landing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something is dissolving." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Dr.Strips+ Sleep launches soon — clinically dosed melatonin in a fast-dissolving strip. Leave your email to be first in line, or enter your password if you already have access." },
    { "type": "text", "id": "email_card_title", "label": "Email card title", "default": "Get early access" },
    { "type": "textarea", "id": "email_card_copy", "label": "Email card copy", "default": "Be the first to know the moment we go live." },
    { "type": "text", "id": "email_placeholder", "label": "Email field placeholder", "default": "Your email" },
    { "type": "text", "id": "email_button_label", "label": "Email button label", "default": "Notify me" },
    { "type": "text", "id": "password_card_title", "label": "Password card title", "default": "Enter the site" },
    { "type": "textarea", "id": "password_card_copy", "label": "Password card copy", "default": "Already have a password? Use it below." },
    { "type": "text", "id": "password_placeholder", "label": "Password field placeholder", "default": "Password" },
    { "type": "text", "id": "password_button_label", "label": "Password button label", "default": "Enter" }
  ]
}
{% endschema %}
