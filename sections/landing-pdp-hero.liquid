{% comment %}
  Section: Product page — hero / buy box — landing-pdp-hero.liquid
{% endcomment %}
{%- liquid
  assign product = all_products[section.settings.product]
  assign variant = product.selected_or_first_available_variant
  assign has_sub_plan = false
  assign sub_plan_id = ''
  assign sub_cents = variant.price
  assign sub_percent_off = 0
  for allocation in variant.selling_plan_allocations
    assign has_sub_plan = true
    assign sub_plan_id = allocation.selling_plan.id
    assign sub_cents = allocation.price
    break
  endfor
  if has_sub_plan and sub_cents < variant.price
    assign sub_savings = variant.price | minus: sub_cents
    assign sub_percent_off = sub_savings | times: 100.0 | divided_by: variant.price | round
  endif
  if has_sub_plan
    assign sub_card_class = 'pdph-plan-card selected'
    assign once_card_class = 'pdph-plan-card'
  else
    assign sub_card_class = 'pdph-plan-card pdph-plan-disabled'
    assign once_card_class = 'pdph-plan-card selected'
  endif
-%}
<section id="top" class="pdph-section">
<div class="pdph-wrap">

<div data-reveal class="pdph-gallery">
<div class="pdph-gallery-main">
{%- if product.images.size > 0 -%}
{%- for image in product.images -%}
<img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: product.title | escape }}" class="pdph-gallery-img{% if forloop.first %} active{% endif %}" data-pdp-gallery-image data-index="{{ forloop.index0 }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="1200" height="{{ 1200 | divided_by: image.aspect_ratio | ceil }}">
{%- endfor -%}
{%- else -%}
<div class="img-slot"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg><span>Add product photos in Shopify admin to show them here</span></div>
{%- endif -%}
</div>
{%- if product.images.size > 1 -%}
<div class="pdph-gallery-thumbs" data-pdp-gallery-thumbs>
{%- for image in product.images -%}
<button type="button" class="pdph-thumb{% if forloop.first %} active{% endif %}" data-pdp-gallery-thumb data-index="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }} of {{ product.images.size }}"{% if forloop.first %} aria-current="true"{% endif %}>
<img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | default: product.title | escape }}" class="pdph-thumb-img" loading="lazy" width="200" height="{{ 200 | divided_by: image.aspect_ratio | ceil }}">
</button>
{%- endfor -%}
</div>
{%- endif -%}
</div>

<div class="pdph-info">
<div data-reveal class="pdph-eyebrow">{{ section.settings.eyebrow }}</div>
<h1 data-reveal class="pdph-heading">{{ section.settings.heading }}</h1>
<p data-reveal class="pdph-lead">{{ section.settings.lead }}</p>

<ul data-reveal class="pdph-no-list">
<li>{{ section.settings.no_1 }}</li>
<li>{{ section.settings.no_2 }}</li>
<li>{{ section.settings.no_3 }}</li>
</ul>

<div data-reveal class="pdph-buybox">
<div class="pdph-plans" role="group" aria-label="Purchase option">
<button type="button" data-plan="sub" class="{{ sub_card_class }}"{% unless has_sub_plan %} disabled aria-disabled="true"{% endunless %} aria-pressed="{{ has_sub_plan }}">
<span class="pdph-plan-radio" aria-hidden="true"></span>
<span class="pdph-plan-copy">
<span class="pdph-plan-row">
<span class="pdph-plan-name">Subscribe & save</span>
{%- if has_sub_plan and sub_percent_off > 0 -%}<span class="pdph-plan-tag">Save {{ sub_percent_off }}%</span>{%- endif -%}
</span>
{%- if has_sub_plan -%}
<span class="pdph-plan-fixed-price">S${{ sub_cents | money | remove: '$' }} <span class="pdph-plan-unit">/ month</span></span>
<span class="pdph-plan-note">Delivered monthly. Pause, skip or cancel anytime.</span>
{%- else -%}
<span class="pdph-plan-note">Subscriptions launching soon.</span>
{%- endif -%}
</span>
</button>
<button type="button" data-plan="once" class="{{ once_card_class }}" aria-pressed="{% if has_sub_plan %}false{% else %}true{% endif %}">
<span class="pdph-plan-radio" aria-hidden="true"></span>
<span class="pdph-plan-copy">
<span class="pdph-plan-row">
<span class="pdph-plan-name">One-time purchase</span>
</span>
<span class="pdph-plan-fixed-price">S${{ variant.price | money | remove: '$' }}</span>
<span class="pdph-plan-note">Delivered once. No commitment.</span>
</span>
</button>
</div>

<div class="pdph-price-row">
<span class="pdph-price" data-cta-price>{% if has_sub_plan %}S${{ sub_cents | money | remove: '$' }} / month{% else %}S${{ variant.price | money | remove: '$' }}{% endif %}</span>
<span class="pdph-price-meta">{{ section.settings.qty_label }}</span>
</div>
<div class="pdph-buy-row">
<div class="pdph-qty" role="group" aria-label="Quantity">
<button type="button" data-pdp-qty-minus class="pdph-qty-btn" aria-label="Decrease quantity">−</button>
<span data-pdp-qty-value class="pdph-qty-value">1</span>
<button type="button" data-pdp-qty-plus class="pdph-qty-btn" aria-label="Increase quantity">+</button>
</div>
<button type="button" data-add-to-bag class="hov-dark hov-dark-lg pdph-buy-btn">{{ section.settings.cta_label }}</button>
</div>
<p class="pdph-guarantee">{{ section.settings.guarantee_text }}</p>
</div>

<div data-reveal class="pdph-accordion">
{%- for block in section.blocks -%}
<details data-faq class="pdph-acc-item" {{ block.shopify_attributes }}>
<summary class="pdph-acc-summary">{{ block.settings.title }}<span data-faq-mark class="pdph-acc-mark">+</span></summary>
<div class="pdph-acc-content">{{ block.settings.content }}</div>
</details>
{%- endfor -%}
</div>
</div>
</div>
</section>

<script>
(function(){
  var thumbs = document.querySelectorAll('[data-pdp-gallery-thumb]');
  var images = document.querySelectorAll('[data-pdp-gallery-image]');
  if (!thumbs.length || !images.length) return;
  for (var i = 0; i < thumbs.length; i++) {
    thumbs[i].addEventListener('click', function(){
      var index = this.getAttribute('data-index');
      for (var t = 0; t < thumbs.length; t++) {
        var active = thumbs[t] === this;
        thumbs[t].classList.toggle('active', active);
        if (active) thumbs[t].setAttribute('aria-current', 'true');
        else thumbs[t].removeAttribute('aria-current');
      }
      for (var g = 0; g < images.length; g++) {
        images[g].classList.toggle('active', images[g].getAttribute('data-index') === index);
      }
      this.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
    }.bind(thumbs[i]));
  }
})();
</script>

{% schema %}
{
  "name": "PDP — Hero",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dr.Strips+ Sleep" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A simpler way to end your day." },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph", "default": "A thoughtfully formulated sleep supplement in a slim oral strip — designed to dissolve into the night you already have, not add a new one." },
    { "type": "text", "id": "no_1", "label": "\"No\" list — item 1", "default": "No bottle to carry." },
    { "type": "text", "id": "no_2", "label": "\"No\" list — item 2", "default": "No water required." },
    { "type": "text", "id": "no_3", "label": "\"No\" list — item 3", "default": "No complicated ritual." },
    { "type": "text", "id": "qty_label", "label": "Quantity label", "default": "30 strips / box" },
    { "type": "text", "id": "cta_label", "label": "Add-to-bag button label", "default": "Add to bag" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "30-night guarantee — try it, and if it's not for you, we'll refund it." },
    { "type": "paragraph", "content": "Gallery images are pulled automatically from this product's photos in Shopify admin (Products → Dr.Strips+ Sleep → Media). Add, remove or reorder them there and this gallery updates to match." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PDP — Hero",
      "blocks": [
        { "type": "item", "settings": { "title": "Description", "content": "<p>Dr.Strips+ Sleep is a fast-dissolving oral strip designed to fit into the wind-down you already have. One strip, on your tongue, about ten minutes before bed — no water, no capsule, nothing to swallow.</p>" } },
        { "type": "item", "settings": { "title": "What it does", "content": "<p>Each strip carries a small, considered blend of actives designed to work with your body's own wind-down signals rather than force sleep on top of it — quieting a racing mind and easing you toward rest, night after night.</p>" } },
        { "type": "item", "settings": { "title": "Ingredients", "content": "<p>Pistachio extract (a natural source of phytomelatonin), GABA, valerian root extract, passion flower and chamomile — five actives, each chosen for a specific mechanism rather than for length of label.</p><p><a href=\"/pages/ingredient-library\">See the complete ingredient breakdown →</a></p>" } },
        { "type": "item", "settings": { "title": "Formula & When to use", "content": "<p>Take one strip on your tongue about ten minutes before bed and let it dissolve on its own — no chewing, no water. One strip a night is the full dose; there's no need to increase it over time.</p>" } },
        { "type": "item", "settings": { "title": "Shipping", "content": "<p>Free shipping on one-time orders above S$100, and free on every subscription. Orders placed before the daily cut-off usually arrive within one to three working days. Singapore only, for now.</p>" } }
      ]
    }
  ]
}
{% endschema %}
