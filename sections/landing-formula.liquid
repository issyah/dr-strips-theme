<section id="formula" class="frm-section">
<div class="frm-wrap">
<div data-reveal class="frm-eyebrow">{{ section.settings.eyebrow }}</div>
<h2 data-reveal class="frm-heading">{{ section.settings.heading }}</h2>
<p data-reveal class="frm-subheading">{{ section.settings.subheading }}</p>

<div class="frm-grid">
<div data-reveal class="hov-card frm-lead-card">
<div class="frm-lead-media">
{%- if section.settings.lead_image != blank -%}
<img src="{{ section.settings.lead_image | image_url: width: 700 }}" alt="{{ section.settings.lead_image.alt | escape }}" class="frm-lead-img" loading="lazy" width="700" height="438">
{%- else -%}
<div class="img-slot"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg><span>{{ section.settings.lead_image_placeholder_text }}</span></div>
{%- endif -%}
</div>
<div class="frm-lead-body">
<div class="frm-lead-meta"><span class="frm-lead-eyebrow">{{ section.settings.lead_eyebrow }}</span><span class="frm-lead-dose">{{ section.settings.lead_dose }}</span></div>
<h3 class="frm-lead-name">{{ section.settings.lead_name }}</h3>
<p class="frm-lead-text">{{ section.settings.lead_text }}</p>
</div>
</div>
<div class="frm-ingredient-list">
{%- assign ingredient_blocks = section.blocks | where: "type", "ingredient" -%}
{%- for block in ingredient_blocks -%}
<div data-reveal class="hov-ingredient frm-ingredient" {{ block.shopify_attributes }}>
<span class="frm-ingredient-dose">{{ block.settings.dose }}</span>
<div><div class="frm-ingredient-name">{{ block.settings.name }}</div><p class="frm-ingredient-text">{{ block.settings.text }}</p></div>
</div>
{%- endfor -%}
</div>
</div>

<div data-reveal class="frm-why">
<div class="frm-why-label">{{ section.settings.why_label }}</div>
<div class="frm-reasons-grid">
{%- assign reason_blocks = section.blocks | where: "type", "reason" -%}
{%- for block in reason_blocks -%}
<div {{ block.shopify_attributes }}><div class="frm-reason-index">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div><h4 class="frm-reason-heading">{{ block.settings.heading }}</h4><p class="frm-reason-text">{{ block.settings.text }}</p></div>
{%- endfor -%}
</div>
<p class="frm-disclaimer">{{ section.settings.disclaimer }}</p>
</div>
</div>
</section>

{% schema %}
{
  "name": "Landing formula",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "05 — The formula" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pistachio, not a synthetic molecule." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Five actives, each chosen for a specific job. Nothing is in the strip to pad the label." },
    { "type": "image_picker", "id": "lead_image", "label": "Lead active image" },
    { "type": "text", "id": "lead_image_placeholder_text", "label": "Lead image placeholder caption", "default": "Ingredient still — pistachios, single-source light" },
    { "type": "text", "id": "lead_eyebrow", "label": "Lead active eyebrow", "default": "Lead active" },
    { "type": "text", "id": "lead_dose", "label": "Lead active dose", "default": "100mg" },
    { "type": "text", "id": "lead_name", "label": "Lead active name", "default": "Pistachio extract" },
    { "type": "textarea", "id": "lead_text", "label": "Lead active text", "default": "One of the richest natural sources of phytomelatonin — the plant-derived form of the same sleep signal your body already reads. It works with your rhythm instead of overriding it." },
    { "type": "text", "id": "why_label", "label": "\"Why melatonin-free\" label", "default": "Why melatonin-free" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Other ingredients: Pullulan, Monk Fruit Extract, Cellulose, Lecithin, Mixed Berry Flavour, Sorbitol Syrup, Steviol Glycosides. Zero sugar. This product is not intended to diagnose, treat, cure or prevent any disease." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "dose", "label": "Dose", "default": "10mg" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "reason",
      "name": "Reason (melatonin-free)",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Landing formula",
      "blocks": [
        { "type": "ingredient", "settings": { "dose": "10mg", "name": "GABA", "text": "The brake pedal. Quietens the loop that keeps replaying at 1am." } },
        { "type": "ingredient", "settings": { "dose": "10mg", "name": "Valerian root extract", "text": "Shortens the gap between lying down and being asleep." } },
        { "type": "ingredient", "settings": { "dose": "10mg", "name": "Passion flower", "text": "For the nights that end wired rather than tired." } },
        { "type": "ingredient", "settings": { "dose": "10mg", "name": "Chamomile", "text": "Apigenin, the compound behind the cup — at a dose a cup can't reach." } },
        { "type": "reason", "settings": { "heading": "No melatonin hangover", "text": "You wake up clear, not weighted. The grogginess people blame on sleep aids is a dosing artefact." } },
        { "type": "reason", "settings": { "heading": "Plant-derived, not synthetic", "text": "Phytomelatonin from pistachio, delivered with its natural cofactors rather than isolated in a lab." } },
        { "type": "reason", "settings": { "heading": "Non-habit forming", "text": "No dependency, no escalating dose. Night thirty works like night three." } }
      ]
    }
  ]
}
{% endschema %}
