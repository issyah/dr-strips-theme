{% comment %}
  Section: Customer account dashboard — main-account.liquid
  Renders at /account. Order history, addresses link, and a subscriptions
  note (a real selling-plan subscription now exists on the product, but
  classic customer accounts have no native self-serve pause/skip/cancel UI —
  that still routes to support until a dedicated subscriber portal exists).
{% endcomment %}
<section class="acct-section">
<div class="acct-dashboard">
<nav class="acct-sidenav">
<a href="{{ routes.account_url }}" class="acct-sidenav-link active">Account</a>
<a href="{{ routes.account_addresses_url }}" class="acct-sidenav-link">Addresses</a>
<a href="{{ routes.account_logout_url }}" class="acct-sidenav-link">Sign out</a>
</nav>
<div class="acct-main">
<h1 class="acct-heading">Welcome back{% if customer.first_name != blank %}, {{ customer.first_name }}{% endif %}</h1>

<div class="acct-card">
<h2 class="acct-card-title">Order history</h2>
{%- if customer.orders_count > 0 -%}
<div class="acct-order-list">
<div class="acct-order-header-row">
<span>Order</span><span>Date</span><span>Payment</span><span>Fulfillment</span><span>Total</span><span></span>
</div>
{%- for order in customer.orders -%}
<div class="acct-order-row">
<span class="acct-order-cell" data-label="Order">{{ order.name }}</span>
<span class="acct-order-cell" data-label="Date">{{ order.created_at | date: "%b %d, %Y" }}</span>
<span class="acct-order-cell" data-label="Payment"><span class="acct-badge">{{ order.financial_status | capitalize }}</span></span>
<span class="acct-order-cell" data-label="Fulfillment"><span class="acct-badge">{{ order.fulfillment_status | capitalize | default: "Unfulfilled" }}</span></span>
<span class="acct-order-cell" data-label="Total">{{ order.total_price | money }}</span>
<span class="acct-order-cell" data-label="Link"><a href="{{ order.customer_url }}" class="acct-link">View order</a></span>
</div>
{%- endfor -%}
</div>
{%- else -%}
<p class="acct-empty-state">You haven't placed any orders yet.</p>
{%- endif -%}
</div>

<div class="acct-card">
<h2 class="acct-card-title">Addresses</h2>
<p class="acct-card-text">Manage your shipping addresses.</p>
<a href="{{ routes.account_addresses_url }}" class="acct-link">Manage addresses</a>
</div>

<div class="acct-subscription-note">
<h2 class="acct-subscription-heading">Subscriptions</h2>
<p class="acct-subscription-text">Dr.Strips+ Sleep is available on a monthly subscription — <a href="{{ routes.root_url }}products/dr-strips-sleep" class="acct-link">subscribe and save on the product page</a>. Self-serve pause, skip, and cancel controls aren't live here yet — for now, to make a change to an existing subscription, contact us at <a href="mailto:support@drstrips.sg" class="acct-link">support@drstrips.sg</a> and we'll take care of it right away.</p>
</div>

</div>
</div>
</section>

{% schema %}
{
  "name": "Account dashboard",
  "tag": "section"
}
{% endschema %}
