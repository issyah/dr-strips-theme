{% comment %}
  Section: Science page — 02 The shortcut (sublingual absorption) — landing-science-mucosa.liquid
{% endcomment %}
<section id="mucosa" class="sm-section">
<div class="sm-container">
<div data-reveal class="sm-eyebrow">{{ section.settings.eyebrow }}</div>
<div class="sm-intro-grid">
<h2 data-reveal class="sm-heading">{{ section.settings.heading }}</h2>
<div>
<p data-reveal class="sm-body">{{ section.settings.body_1 }}</p>
<p data-reveal class="sm-body--second">{{ section.settings.body_2 }}</p>
<div data-reveal class="sm-citation">{{ section.settings.citation }}</div>
</div>
</div>

<div class="sm-content-grid">
<div data-reveal class="hov-card sm-image-card">
<div class="sm-image-wrap">
{%- if section.settings.image != blank -%}
<img src="{{ section.settings.image | image_url: width: 700 }}" alt="{{ section.settings.image.alt | escape }}" class="sm-image" loading="lazy" width="700" height="481">
{%- else -%}
<div class="img-slot"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg><span>{{ section.settings.image_placeholder_text }}</span></div>
{%- endif -%}
</div>
<div class="sm-image-card-body">
<div class="sm-image-card-label">{{ section.settings.image_card_label }}</div>
<h3 class="sm-image-card-title">{{ section.settings.image_card_title }}</h3>
<p class="sm-image-card-text">{{ section.settings.image_card_text }}</p>
</div>
</div>
<div class="sm-points">
{%- for block in section.blocks -%}
<div data-reveal class="hov-card sm-point" {{ block.shopify_attributes }}>
<span class="sm-point-index">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
<div><div class="sm-point-title">{{ block.settings.title }}</div><p class="sm-point-text">{{ block.settings.text }}</p></div>
</div>
{%- endfor -%}
<div data-reveal class="hov-card sm-callout">
<div class="sm-callout-label">{{ section.settings.borrowed_label }}</div>
<p class="sm-callout-text">{{ section.settings.borrowed_text }}</p>
</div>
</div>
</div>
</div>
</section>

{% schema %}
{
  "name": "Science — The shortcut",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "02 — The shortcut" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The tissue under your tongue was built for this." },
    { "type": "textarea", "id": "body_1", "label": "Body text 1", "default": "The floor of your mouth is one of the most permeable surfaces on the body: a thin, non-keratinised membrane sitting directly over a dense bed of capillaries. Anything that crosses it enters the veins draining the head and neck — which feed general circulation without passing through the liver." },
    { "type": "textarea", "id": "body_2", "label": "Body text 2", "default": "No stomach. No gut wall. No first pass. Delivered this way, compounds suited to the route reach far more of the bloodstream than the same compounds swallowed." },
    { "type": "text", "id": "citation", "label": "Citation", "default": "British Journal of Clinical Pharmacology, 2018" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_placeholder_text", "label": "Image placeholder caption", "default": "Macro — strip on the tongue, mid-dissolve, single-source light" },
    { "type": "text", "id": "image_card_label", "label": "Image card label", "default": "Where it happens" },
    { "type": "text", "id": "image_card_title", "label": "Image card title", "default": "A membrane, then blood" },
    { "type": "textarea", "id": "image_card_text", "label": "Image card text", "default": "The film holds itself against the mucosa while it dissolves, so the actives are released exactly where the tissue is thinnest and the capillaries are closest." },
    { "type": "text", "id": "borrowed_label", "label": "Callout label", "default": "Borrowed, not invented" },
    { "type": "textarea", "id": "borrowed_text", "label": "Callout text", "default": "Medicine has used this route for decades: nitroglycerin placed under the tongue for angina, sublingual B12, prescription oral films. We did not discover the shortcut. We built a nightly supplement around it." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Science — The shortcut",
      "blocks": [
        { "type": "point", "settings": { "title": "Thin, non-keratinised membrane", "text": "Nothing like the barrier lining your gut. It is built to let things through." } },
        { "type": "point", "settings": { "title": "A dense capillary bed beneath it", "text": "Blood sits millimetres from the surface, which is why absorption starts in minutes rather than an hour." } },
        { "type": "point", "settings": { "title": "Straight into systemic circulation", "text": "The veins draining your mouth do not route through the liver, so nothing is metabolised before it can work." } }
      ]
    }
  ]
}
{% endschema %}
