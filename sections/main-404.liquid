{% comment %}
  Section: 404 Not Found page — main-404.liquid
{% endcomment %}
<section class="e404-section">
<div class="e404-wrap">
<div data-reveal class="e404-eyebrow"><span class="e404-eyebrow-line"></span>{{ section.settings.eyebrow }}</div>
<h1 data-reveal class="e404-heading">{{ section.settings.heading }}</h1>
<p data-reveal class="e404-line">{{ section.settings.line_1 }}</p>
<p data-reveal class="e404-line e404-line-emphasis">{{ section.settings.line_2 }}</p>
<a data-reveal href="{{ section.settings.cta_url }}" class="e404-cta">{{ section.settings.cta_label }}</a>
</div>
</section>
{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Looks like you've gone off-script." },
    { "type": "text", "id": "line_1", "label": "Line 1", "default": "This page doesn't exist." },
    { "type": "text", "id": "line_2", "label": "Line 2", "default": "But your better nightly routine still can." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Dr.Strips+ Sleep" },
    { "type": "text", "id": "cta_url", "label": "Button URL", "default": "/products/dr-strips-sleep" }
  ],
  "presets": [
    { "name": "404 page" }
  ]
}
{% endschema %}
