<p class="ftr-tagline">{{ section.settings.tagline }}</p>
</div>
{%- for block in section.blocks -%}
{%- if block.type == 'link_column' -%}
<div class="ftr-link-column" {{ block.shopify_attributes }}>
{%- for i in (1..4) -%}
{%- assign label_key = 'link_' | append: i | append: '_label' -%}
{%- assign url_key = 'link_' | append: i | append: '_url' -%}
{%- assign label = block.settings[label_key] -%}
{%- if label != blank -%}<a href="{{ block.settings[url_key] }}" class="ftr-link">{{ label }}</a>{%- endif -%}
{%- endfor -%}
</div>
{%- endif -%}
{%- endfor -%}
</div>
<div class="ftr-bottom">
<span>{{ section.settings.copyright }}</span><span>{{ section.settings.disclaimer }}</span>
</div>
</div>
</footer>

<div class="toast" id="toast" role="status" aria-live="polite">
<span id="toastText">Added</span>
<span id="toastBagLabel" class="ftr-toast-bag-label">Bag · 0</span>
</div>

{% schema %}
{
  "name": "Landing footer",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Strip2Cell sleep film. The dose on the box, dissolved in sixty seconds." },
    { "type": "text", "id": "copyright", "label": "Copyright line", "default": "© 2026 FreshPharm · Singapore" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer line", "default": "Not intended to diagnose, treat, cure or prevent any disease" }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "link_1_label", "label": "Link 1 label", "default": "Science" },
        { "type": "text", "id": "link_1_url", "label": "Link 1 url (anchor or URL)", "default": "#science" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 label", "default": "How it works" },
        { "type": "text", "id": "link_2_url", "label": "Link 2 url (anchor or URL)", "default": "#how" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 label" },
        { "type": "text", "id": "link_3_url", "label": "Link 3 url (anchor or URL)" },
        { "type": "text", "id": "link_4_label", "label": "Link 4 label" },
        { "type": "text", "id": "link_4_url", "label": "Link 4 url (anchor or URL)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Landing footer",
      "blocks": [
        { "type": "link_column", "settings": { "link_1_label": "Science", "link_1_url": "#science", "link_2_label": "How it works", "link_2_url": "#how", "link_3_label": "Formula", "link_3_url": "#formula", "link_4_label": "Buy", "link_4_url": "#offer" } },
        { "type": "link_column", "settings": { "link_1_label": "FAQ", "link_1_url": "#faq", "link_2_label": "Shipping", "link_2_url": "#offer", "link_3_label": "Refunds", "link_3_url": "#offer", "link_4_label": "Contact", "link_4_url": "#top" } }
      ]
    }
  ]
}
{% endschema %}
